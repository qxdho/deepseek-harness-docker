# dshm 生成的实例配置示例。
# 正常安装不需要手抄：dshm docker install 会写入 /opt/dsh/.env（权限 600）。
# .env 含密码，切勿提交。

# ── 镜像 ────────────────────────────────────────────────────────────────────
DSH_IMAGE=ghcr.io/qxdho/deepseek-harness-docker:latest

# ── 宿主侧：对外访问 ────────────────────────────────────────────────────────
# 宿主机监听端口。容器内固定 3080，与此无关。
DSH_HTTP_PORT=3080
# 127.0.0.1 = 只有宿主机（配反代/SSH 隧道）；0.0.0.0 = 局域网可直连。
DSH_BIND=127.0.0.1

# ── 宿主侧：数据与工作区 ────────────────────────────────────────────────────
# 数据根：settings.yaml、.credentials.yaml、profiles/、sessions/、storages/ 等。
DSH_HOME_HOST=/opt/dsh/data
DSH_HOME_CONTAINER=/dsh
# 工作区是独立挂载，不要指向数据目录内部。
DSH_WORKSPACE_HOST=/opt/dsh/workspace
DSH_WORKSPACE_CONTAINER=/workspace
DSH_CONTAINER_HOME=/workspace

# 容器运行身份。bind mount 的属主必须与它一致。
DSH_UID=1000
DSH_GID=1000

# 工作区不可写时：0 = 降级到容器内 .workspace 继续启动；1 = 直接失败。
DSH_WORKSPACE_STRICT=0
# 磁盘余量低于该值（MB）时拒绝启动。
DSH_DISK_MIN_MB=256

# ── 登录（dsh-web-startup-auth）─────────────────────────────────────────────
DSH_AUTH_USER=admin
# 仅首次启动预置管理员用；至少 14 位。
# 改密码：dshm docker auth reset
DSH_AUTH_PASSWORD=请换成至少14位且含大小写/数字/符号的强密码
# v2 没有 TOTP；只能写 off 或 optional。
DSH_AUTH_TOTP=optional

# ── HTTPS 反代 ──────────────────────────────────────────────────────────────
# 只影响对外 URL；Cookie 的 Secure 由 Nginx 的 proxy_cookie_flags 补。
DSH_COOKIE_SECURE=0
# 对外域名；会作为 --trusted-host/--public-url 传给 dsh。
DSH_PUBLIC_HOST=

# ── 构建期（仅本地构建镜像时用）────────────────────────────────────────────
DSH_VERSION=0.2.2-rc.1
DSH_WEB_AUTH_VERSION=0.1.14
# none = 精简运行镜像；full = 额外装 python3/make/g++（容器内编译原生插件）
DSH_DEV_TOOLS=none
