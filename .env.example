# 复制为 .env 后填写；.env 含密码，切勿提交。

# ── 镜像 ────────────────────────────────────────────────────────────────────
# 默认拉 GHCR 上 Actions 构建好的镜像；本地构建时可用 :local 之类覆盖
DSH_IMAGE=ghcr.io/qxdho/deepseek-harness-docker:latest
# 内置的 dsh 版本（本地构建时生效）
DSH_VERSION=0.1.7-rc.2
# 内置的登录插件版本
AUTH_GATE_VERSION=0.15.0
# none = 精简运行镜像；full = 额外装 python3/make/g++（容器内编译带原生依赖的插件）
DEV_TOOLS=none

# ── 网络 ────────────────────────────────────────────────────────────────────
# 宿主机端口
PROXY_PORT=3080
# 绑定地址。默认 127.0.0.1：只有宿主机能访问，适合你在宿主机上加 HTTPS 反代。
# 未加反代、想直接从局域网访问时改成 0.0.0.0。
DSH_BIND=127.0.0.1

# ── 登录（dsh-auth-gate）────────────────────────────────────────────────────
DSH_AUTH_USER=admin
# 必填。首次启动用它创建管理员；之后改密码用 ./dshm password
DSH_AUTH_PASSWORD=请换成至少14位且含大小写/数字/符号的强密码
# off | optional | required（两步验证 TOTP）
DSH_TOTP=optional
# 【可选】HTTPS 下建议设为 1（会话 Cookie 带 Secure）；纯 HTTP 访问必须保持 0
DSH_COOKIE_SECURE=0
# 【可选】登录页显示的域名，例如 dsh.example.com。留空则显示回环地址，不影响功能
DSH_PUBLIC_HOST=

# ── 模型（可选）─────────────────────────────────────────────────────────────
# 填了就直接用；不填也可以登录后在网页「设置 → 模型」里配置（会存进持久化卷）。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 工作区 ──────────────────────────────────────────────────────────────────
# agent 的工作目录，挂到容器 /workspace
DSH_WORKSPACE=./workspace
