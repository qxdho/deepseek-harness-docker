# 复制为 .env 后填写。.env 含密码，切勿提交。

# ── 网络 ────────────────────────────────────────────────────────────────────
# 宿主机端口
PROXY_PORT=3080
# 127.0.0.1 = 只有宿主机能访问（配反代）；0.0.0.0 = 局域网可直连
DSH_BIND=127.0.0.1

# ── 登录 ────────────────────────────────────────────────────────────────────
DSH_AUTH_USER=admin
# 必填。仅首次启动建号用；≥14 位且含大小写/数字/符号。之后改密码：./dshm pw
DSH_AUTH_PASSWORD=请换成至少14位且含大小写/数字/符号的强密码
# off | optional | required（两步验证）
DSH_TOTP=optional
# HTTPS 设为 1；纯 HTTP 必须为 0
DSH_COOKIE_SECURE=0
# 登录页显示的域名，可留空
DSH_PUBLIC_HOST=

# ── 数据目录（宿主 bind 挂载，两边都可配置）──────────────────────────────────
# dsh 把所有用户数据放在一个根目录里（DSH_HOME）：settings.yaml、.credentials.yaml、
# profiles/（插件）、sessions/（会话）、storages/、attachments/、llm-deepseek/ 等。
# DSH_HOME 就是根目录本身，不会再拼一层 .dsh。
#
#     宿主 DSH_HOME_HOST  ──bind──▶  容器 DSH_HOME
#
# 默认宿主 /dsh、容器 /dsh。首次创建宿主 /dsh 需要 root/sudo；换成你自己拥有的
# 目录（例如 $HOME/dsh）就不需要。改完必须 ./dshm service up。
DSH_HOME_HOST=/dsh
DSH_HOME=/dsh

# ── 工作区（同样两边可配置）─────────────────────────────────────────────────
# 宿主默认跟随数据目录：DSH_HOME_HOST/workspace；容器内默认 /workspace。
# 属主必须是容器内 uid（默认 1000），./install.sh 与 ./dshm service up 会检查并修正。
DSH_WORKSPACE=/dsh/workspace
DSH_WORKSPACE_CONTAINER=/workspace
# 1 = 工作区不可写时直接退出（会反复重启）；默认 0 = 降级到容器内目录继续启动
# DSH_WORKSPACE_STRICT=0

# ── 容器身份（宿主 uid 不是 1000 时才需要改）─────────────────────────────────
# 数据目录与工作区都是 bind mount，属主由宿主决定。填 `id -u` / `id -g` 让它们
# 天然匹配，无需 chown。
# DSH_UID=1000
# DSH_GID=1000

# ── 模型（可选）─────────────────────────────────────────────────────────────
# 也可登录后在网页「设置 → 模型」里配置
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 构建期（改了需重建镜像）─────────────────────────────────────────────────
# 默认拉 GHCR 上 CI 构建好的镜像
DSH_IMAGE=ghcr.io/qxdho/deepseek-harness-docker:latest
# 镜像内置的 dsh 版本
DSH_VERSION=0.1.7-rc.2
# 镜像内置的登录插件版本
AUTH_GATE_VERSION=0.15.0
# none = 精简运行镜像；full = 额外装 python3/make/g++（容器内编译原生插件）
DEV_TOOLS=none

# ── 管理面板（./dshm admin install 自动写入，一般不用手改）──────────────────
# 面板是宿主机上的一个进程（不额外起容器）。二进制、配置、pidfile、日志都放在
# DSH_ADMIN_DIR 这一个目录里，默认 /dsh-manager（根目录下，首次创建要 sudo）。
# 没有 root 就改成你自己的目录，例如：
#   DSH_ADMIN_DIR=$HOME/dsh-manager
# 有 root（或免密 sudo）时用 systemd 常驻、开机自启；否则用 pidfile 后台运行。
DSH_ADMIN_DIR=/dsh-manager
# 面板监听；默认只绑本机
# DSH_ADMIN_PORT=3090
# DSH_ADMIN_BIND=127.0.0.1
