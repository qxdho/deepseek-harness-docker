# 复制为 .env 后填写。.env 含密码，切勿提交。
#
# 键名约定：
#   * 本项目自己的配置一律 DSH_ 前缀，构建期参数也一样；
#   * 宿主侧路径用 _HOST 结尾，容器侧路径用 _CONTAINER 结尾；
#   * 有默认值的项，install.sh 直接采用，不会逐项询问（只有登录密码必填）。
#
# 旧键（PROXY_PORT / DSH_WORKSPACE / DSH_HOME / DSH_TOTP / AUTH_GATE_VERSION /
# DEV_TOOLS）会在 ./install.sh 或 ./dshm service up 时自动改名为新键，值不变。

# ── 1. 宿主侧：对外访问 ─────────────────────────────────────────────────────
# 宿主发布端口（容器内代理固定 3080，与它无关）
DSH_HTTP_PORT=3080
# 127.0.0.1 = 只有宿主机能访问（配反代）；0.0.0.0 = 局域网可直连
DSH_BIND=127.0.0.1

# ── 2. 宿主侧：数据与工作区目录（bind 挂载，两侧路径都可配置）──────────────
# dsh 把所有用户数据放在一个根目录里（DSH_HOME）：settings.yaml、.credentials.yaml、
# profiles/（插件）、sessions/（会话）、storages/、attachments/、llm-deepseek/ 等。
# DSH_HOME_CONTAINER 就是根目录本身，不会再拼一层 .dsh。
#
#     宿主 DSH_HOME_HOST  ──bind──▶  容器 DSH_HOME_CONTAINER
#
# 默认宿主 /dsh，首次创建需要 root/sudo；换成你自己拥有的目录（例如
# /home/你的用户名/dsh）就不需要。改完必须 ./dshm service up。
# 注意：这两个值会原样交给 Docker，Compose 不展开 ~ 和 $HOME，必须写绝对路径。
DSH_HOME_HOST=/dsh
DSH_HOME_CONTAINER=/dsh
# 工作区：宿主侧与容器侧都是**独立配置**的绝对路径，不跟随数据目录。
# 属主必须是容器内 uid（默认 1000），./install.sh 与 ./dshm service up 会检查并修正。
DSH_WORKSPACE_HOST=/dsh/workspace
DSH_WORKSPACE_CONTAINER=/workspace
# 1 = 工作区不可写时直接退出（会反复重启）；默认 0 = 降级到容器内目录继续启动
# DSH_WORKSPACE_STRICT=0
# 启动时磁盘余量低于该值（MB）就告警/拒绝启动，默认 256
# DSH_DISK_MIN_MB=256
# 容器运行身份。数据目录与工作区都是 bind mount，属主由宿主决定；
# 宿主 uid 不是 1000 时填 `id -u` / `id -g`，让两边天然匹配，无需 chown。
# DSH_UID=1000
# DSH_GID=1000

# ── 3. 登录（dsh-auth-gate 插件）────────────────────────────────────────────
DSH_AUTH_USER=admin
# 必填。仅首次启动建号用；≥14 位且含大小写/数字/符号。之后改密码：./dshm auth password
DSH_AUTH_PASSWORD=请换成至少14位且含大小写/数字/符号的强密码
# off | optional | required（两步验证）
DSH_AUTH_TOTP=optional

# ── 4. 反向代理（在 dsh 前面加 HTTPS/域名时）────────────────────────────────
# HTTPS 设为 1；纯 HTTP 必须为 0
DSH_COOKIE_SECURE=0
# 登录页显示的域名，可留空
DSH_PUBLIC_HOST=
# 置 1 后代理信任 X-Forwarded-For，取最右一项作为客户端真实地址（用于登录审计
# 与限流）。只有确实有反代在改写该头时才开，否则客户端可伪造。
# DSH_TRUST_XFF=0
# dsh 自身从哪个请求头取客户端 IP（仅在本机反代直连时可信）
# DSH_CLIENT_IP_HEADER=x-forwarded-for
# 容器内代理等待上游响应的超时（毫秒），超时返回 504。
# dsh 若只接受 TCP 却不回包，没有这个上限请求会一直挂着（浏览器转圈、连接与
# socket 一直被占）。默认 120000，一般不用改。
# DSH_PROXY_TIMEOUT_MS=120000

# ── 5. 管理面板（./dshm admin install 自动写入，一般不用手改）───────────────
# 面板是宿主机上的一个进程（不额外起容器）。二进制、配置、pidfile、日志都放在
# DSH_ADMIN_DIR 这一个目录里，默认 /dsh-manager（根目录下，首次创建要 sudo）。
# 没有 root 就改成你自己的目录（该值由 dshm 读取，可用 $HOME）：
#   DSH_ADMIN_DIR=$HOME/dsh-manager
# 有 root（或免密 sudo）时用 systemd 常驻、开机自启；否则用 pidfile 后台运行。
DSH_ADMIN_DIR=/dsh-manager
# 面板监听；默认只绑本机
# DSH_ADMIN_PORT=3090
# DSH_ADMIN_BIND=127.0.0.1

# ── 6. 构建期（改了需重建镜像）──────────────────────────────────────────────
# 默认拉 GHCR 上 CI 构建好的镜像
DSH_IMAGE=ghcr.io/qxdho/deepseek-harness-docker:latest
# 镜像内置的 dsh 版本
DSH_VERSION=0.2.0-rc.2
# 镜像内置的登录插件版本
DSH_AUTH_GATE_VERSION=0.16.0
# none = 精简运行镜像；full = 额外装 python3/make/g++（容器内编译原生插件）
DSH_DEV_TOOLS=none

# ── 由镜像/compose 注入，不要写进 .env ──────────────────────────────────────
# 上游 dsh 自己的变量：DSH_HOME（= 上面的 DSH_HOME_CONTAINER）、DSH_HOST、DSH_PORT、
# DSH_PERMISSION_MODE、DSH_TELEMETRY_DISABLED；容器内代理的 PROXY_PORT 固定 3080。
# 模型密钥 DEEPSEEK_API_KEY 可以直接写进本文件（或者登录后在网页「设置 → 模型」配）。
