# 复制为 .env 后填写。.env 含密码，切勿提交。

# ── 网络 ────────────────────────────────────────────────────────────────────
# 宿主机端口
PROXY_PORT=3080
# 127.0.0.1 = 只有宿主机能访问（配反代）；0.0.0.0 = 局域网可直连
DSH_BIND=127.0.0.1

# ── 登录 ────────────────────────────────────────────────────────────────────
DSH_AUTH_USER=admin
# 必填。仅首次启动建号用；≥14 位且含大小写/数字/符号。之后改密码：./dshm pw
DSH_AUTH_PASSWORD=请换成至少14位且含大小写/数字/符号的强密码
# off | optional | required（两步验证）
DSH_TOTP=optional
# HTTPS 设为 1；纯 HTTP 必须为 0
DSH_COOKIE_SECURE=0
# 登录页显示的域名，可留空
DSH_PUBLIC_HOST=

# ── 工作区 ──────────────────────────────────────────────────────────────────
# agent 工作目录，挂到容器 /workspace。属主必须是容器内 uid（默认 1000），
# ./install.sh 与 ./dshm up 会检查并修正；手工修：sudo chown -R 1000:1000 ./workspace
DSH_WORKSPACE=./workspace
# 1 = /workspace 不可写时直接退出（会反复重启）；默认 0 = 降级到容器内目录继续启动
# DSH_WORKSPACE_STRICT=0

# ── 容器身份（宿主 uid 不是 1000 时才需要改）─────────────────────────────────
# 填 `id -u` / `id -g`，bind mount 属主即天然匹配，无需 chown
# DSH_UID=1000
# DSH_GID=1000

# ── 模型（可选）─────────────────────────────────────────────────────────────
# 也可登录后在网页「设置 → 模型」里配置
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 构建期（改了需重建镜像）─────────────────────────────────────────────────
# 默认拉 GHCR 上 CI 构建好的镜像
DSH_IMAGE=ghcr.io/qxdho/deepseek-harness-docker:latest
# 镜像内置的 dsh 版本
DSH_VERSION=0.1.7-rc.2
# 镜像内置的登录插件版本
AUTH_GATE_VERSION=0.15.0
# none = 精简运行镜像；full = 额外装 python3/make/g++（容器内编译原生插件）
DEV_TOOLS=none
