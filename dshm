#!/usr/bin/env bash
# dshm — dsh-docker 的独立安装/管理工具。
#
#   dshm update                   更新 dshm 自己
#   dshm version                  看 dshm / 镜像 / 容器版本
#   dshm docker install           安装 dsh-docker
#   dshm docker update [--to tag] 更新 dsh-docker 镜像
#   dshm docker rollback          回退到上一个镜像
#   dshm docker status|logs|up|down|restart|shell|url
#   dshm docker config show|get|set|edit
#   dshm docker auth reset
#   dshm docker doctor
#   dshm docker uninstall [--purge]
#
# 不再要求 clone 仓库：模板、脚本都随 dshm 发布包走。
set -euo pipefail

# ── 自身定位（支持被 symlink 到 PATH）──────────────────────────────────────
SELF="$0"
while [ -L "$SELF" ]; do
	link="$(readlink "$SELF")"
	case "$link" in
	/*) SELF="$link" ;;
	*) SELF="$(dirname "$SELF")/$link" ;;
	esac
done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
CLI_NAME=dshm

DSHM_VERSION_RAW="${DSHM_VERSION:-__VERSION__}"
DSHM_REPO="${DSHM_REPO_URL:-https://github.com/qxdho/deepseek-harness-docker}"
DEFAULT_IMAGE="ghcr.io/qxdho/deepseek-harness-docker:latest"
DEFAULT_CONTAINER="qxdho-dsh"

# shellcheck source=scripts/log.sh
. "$SELF_DIR/scripts/log.sh"

# .env 读写（get_env/set_env/env_validate_password/read_secret）
ENV_FILE=""
# shellcheck source=scripts/env-config.sh
. "$SELF_DIR/scripts/env-config.sh"

# ── 版本 ────────────────────────────────────────────────────────────────────
dshm_version() {
	if [ "$DSHM_VERSION_RAW" != "__VERSION__" ]; then
		printf '%s' "$DSHM_VERSION_RAW"
	elif [ -f "$SELF_DIR/VERSION" ]; then
		tr -d ' \t\r\n' <"$SELF_DIR/VERSION"
	elif command -v git >/dev/null 2>&1 && [ -d "$SELF_DIR/.git" ]; then
		git -C "$SELF_DIR" describe --tags --always 2>/dev/null || printf 'dev'
	else
		printf 'dev'
	fi
}

# ── 实例目录 ────────────────────────────────────────────────────────────────
config_file() { printf '%s/dshm/config' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

remember_app_dir() {
	local d="$1" cfg
	cfg="$(config_file)"
	mkdir -p "$(dirname "$cfg")"
	printf 'APP_DIR=%q\n' "$d" >"$cfg"
	chmod 600 "$cfg" 2>/dev/null || true
}

resolve_app_dir() {
	if [ -n "${DSHM_APP_DIR:-}" ]; then
		printf '%s' "$DSHM_APP_DIR"
		return
	fi
	local cfg
	cfg="$(config_file)"
	if [ -f "$cfg" ]; then
		# shellcheck source=/dev/null
		. "$cfg"
		if [ -n "${APP_DIR:-}" ]; then printf '%s' "$APP_DIR"; return; fi
	fi
	# 兼容：直接放在仓库目录里运行时，用仓库目录
	if [ -f "$SELF_DIR/.env" ] && [ -f "$SELF_DIR/docker-compose.yml" ]; then
		printf '%s' "$SELF_DIR"
		return
	fi
	printf ''
}

default_app_dir() {
	if [ "$(id -u)" = "0" ]; then
		printf '/opt/dsh'
	else
		printf '%s/dshm/default' "${XDG_DATA_HOME:-$HOME/.local/share}"
	fi
}

APP_DIR=""
STATE=""
CONTAINER="$DEFAULT_CONTAINER"

set_app() {
	APP_DIR="$1"
	STATE="$APP_DIR/state.json"
	ENV_FILE="$APP_DIR/.env"
}

require_app() {
	if [ -z "$APP_DIR" ] || [ ! -f "$APP_DIR/.env" ]; then
		die "找不到实例。先运行 dshm docker install，或用 --dir /path 指定。"
	fi
	[ -f "$STATE" ] || die "缺少状态文件 $STATE（可用 dshm docker install 重建，或从备份恢复）"
	ENV_FILE="$APP_DIR/.env"
	CONTAINER="$(state_get container)"
	[ -n "$CONTAINER" ] || CONTAINER="$DEFAULT_CONTAINER"
}

# ── 状态文件 ────────────────────────────────────────────────────────────────
state_get() {
	[ -f "$STATE" ] || return 0
	sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$STATE" 2>/dev/null | head -1
}

write_state() { # <image> <previous>
	local image="$1" previous="${2:-}" tmp
	tmp="$STATE.tmp.$$"
	cat >"$tmp" <<EOF
{
  "schema": 1,
  "container": "${CONTAINER}",
  "image": "${image}",
  "previous_image": "${previous}",
  "installed_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
	mv "$tmp" "$STATE"
	chmod 600 "$STATE" 2>/dev/null || true
}

# ── docker compose ──────────────────────────────────────────────────────────
require_docker() {
	command -v docker >/dev/null 2>&1 || die "未安装 docker"
	docker compose version >/dev/null 2>&1 || die "未安装 docker compose v2"
}

compose() {
	( cd "$APP_DIR" && docker compose --env-file "$APP_DIR/.env" "$@" )
}

container_health() {
	docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$CONTAINER" 2>/dev/null || true
}

wait_healthy() {
	local port="$1" i code
	for i in $(seq 1 180); do
		[ "$(container_health)" = "healthy" ] && return 0
		sleep 1
	done
	# 没有 healthcheck 时用 /login 兜底
	for i in $(seq 1 30); do
		code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:${port}/login" 2>/dev/null || true)"
		[ "$code" = "200" ] && return 0
		sleep 1
	done
	return 1
}

print_url() {
	local bind port
	bind="$(get_env DSH_BIND "$ENV_FILE")"; bind="${bind:-127.0.0.1}"
	port="$(get_env DSH_HTTP_PORT "$ENV_FILE")"; port="${port:-3080}"
	if [ "$bind" = "0.0.0.0" ]; then
		printf '    http://<服务器IP>:%s/\n' "$port"
	else
		printf '    http://127.0.0.1:%s/（仅在宿主机可访问，请用反代或 SSH 隧道）\n' "$port"
	fi
}

# ── 安装 ────────────────────────────────────────────────────────────────────
write_compose_file() {
	[ -f "$SELF_DIR/templates/compose.yaml" ] || die "发布包缺少 templates/compose.yaml"
	cp "$SELF_DIR/templates/compose.yaml" "$APP_DIR/docker-compose.yml"
}

write_env_file() { # <image> <port> <bind> <data_dir> <uid> <gid> <password> <container>
	local image="$1" port="$2" bind="$3" data_dir="$4" uid="$5" gid="$6" password="$7" container="$8"
	[ -n "$container" ] || die "--container 不能为空"
	case "$container" in *[!A-Za-z0-9_.-]*) die "--container 只能包含字母、数字、_ . -" ;; esac
	CONTAINER="$container"
	{
		printf '# dshm 生成的实例配置；修改后执行 dshm docker up 重建容器。\n'
		printf '# 本文件含密码，权限必须保持 600。\n\n'
		printf '# 容器与镜像\n'
		printf 'DSHM_CONTAINER=%s\n' "$container"
		printf 'DSH_IMAGE=%s\n' "$image"
		printf '\n# 对外访问\n'
		printf 'DSH_HTTP_PORT=%s\n' "$port"
		printf 'DSH_BIND=%s\n' "$bind"
		printf '\n# 数据与工作区（bind mount；属主必须与下面的 UID/GID 一致）\n'
		printf 'DSH_HOME_HOST=%s\n' "$data_dir"
		printf 'DSH_HOME_CONTAINER=/dsh\n'
		printf 'DSH_WORKSPACE_HOST=%s\n' "$APP_DIR/workspace"
		printf 'DSH_WORKSPACE_CONTAINER=/workspace\n'
		printf '# 目录选择器默认从这里开始；默认 /workspace。\n'
		printf 'DSH_CONTAINER_HOME=/workspace\n'
		printf 'DSH_UID=%s\n' "$uid"
		printf 'DSH_GID=%s\n' "$gid"
		printf '\n# 启动保护\n'
		printf 'DSH_DISK_MIN_MB=256\n'
		printf 'DSH_WORKSPACE_STRICT=0\n'
		printf '\n# 登录（dsh-web-startup-auth）\n'
		printf '# 密码仅首次启动预置管理员用；已有 web-auth.json 后改这里无效。\n'
		printf '# 改密码用：dshm docker auth reset\n'
		printf 'DSH_AUTH_USER=admin\n'
		printf 'DSH_AUTH_PASSWORD=%s\n' "$password"
		printf '# v2 没有 TOTP；只能填 off 或 optional，required 会报错。\n'
		printf 'DSH_AUTH_TOTP=optional\n'
		printf '\n# HTTPS 反代（Cookie Secure 由 Nginx 的 proxy_cookie_flags 补）\n'
		printf '# 对外域名，例如 dsh.example.com；留空则按绑定地址。\n'
		printf 'DSH_PUBLIC_HOST=\n'
		printf '# 只影响对外 URL 的 scheme；HTTPS 设为 1。\n'
		printf 'DSH_COOKIE_SECURE=0\n'
	} >"$APP_DIR/.env"
	chmod 600 "$APP_DIR/.env"
}

install_existing() {
	ENV_FILE="$APP_DIR/.env"
	if [ "${DRY_RUN:-0}" = "1" ]; then
		ok "dry-run：使用已有 .env，不会启动"
		print_url
		return 0
	fi
	require_docker
	[ -f "$STATE" ] && die "$APP_DIR 已经安装过；升级用 dshm docker update，回退用 rollback"
	[ -f "$APP_DIR/docker-compose.yml" ] || write_compose_file

	local image port bind data_dir password container p1 p2
	image="$(get_env DSH_IMAGE "$ENV_FILE")"
	port="$(get_env DSH_HTTP_PORT "$ENV_FILE")"; port="${port:-3080}"
	bind="$(get_env DSH_BIND "$ENV_FILE")"; bind="${bind:-127.0.0.1}"
	data_dir="$(get_env DSH_HOME_HOST "$ENV_FILE")"
	password="$(get_env DSH_AUTH_PASSWORD "$ENV_FILE")"
	container="$(get_env DSHM_CONTAINER "$ENV_FILE")"; container="${container:-$DEFAULT_CONTAINER}"
	[ -n "$image" ] || die ".env 缺少 DSH_IMAGE"
	[ -n "$data_dir" ] || die ".env 缺少 DSH_HOME_HOST"
	[ -n "$(get_env DSH_WORKSPACE_HOST "$ENV_FILE")" ] || die ".env 缺少 DSH_WORKSPACE_HOST"
	if [ -z "$password" ]; then
		hdr "设置 dsh 登录密码"
		read_secret "  密码："; p1="$SECRET"
		read_secret "  再输一次："; p2="$SECRET"
		[ "$p1" = "$p2" ] || die "两次输入不一致"
		password="$p1"
		set_env DSH_AUTH_PASSWORD "$password"
	fi
	[ "${#password}" -ge 14 ] || die "DSH_AUTH_PASSWORD 至少 14 位"
	CONTAINER="$container"
	mkdir -p "$data_dir" "$APP_DIR/workspace"

	remember_app_dir "$APP_DIR"
	[ "$NO_PULL" != "1" ] && { hdr "拉取镜像"; compose pull || die "镜像拉取失败：$image"; }
	hdr "启动 dsh-docker"
	compose up -d || die "docker compose up 失败"
	if ! wait_healthy "$port"; then
		compose logs --tail=80 || true
		die "容器未在预期时间内健康"
	fi
	write_state "$image" ""
	ok "dsh-docker 已启动"
	hdr "访问地址"
	print_url
	info "实例目录：$APP_DIR"
}

cmd_docker_init() {
	local dir="${APP_DIR:-}" image="${DSHM_IMAGE:-$DEFAULT_IMAGE}" port=3080 bind=127.0.0.1
	local data_dir="" uid gid container="${DSHM_CONTAINER:-$DEFAULT_CONTAINER}"
	while [ $# -gt 0 ]; do
		case "$1" in
		--dir | --app-dir) dir="${2:-}"; shift ;;
		--data-dir) data_dir="${2:-}"; shift ;;
		--port) port="${2:-}"; shift ;;
		--bind) bind="${2:-}"; shift ;;
		--image) image="${2:-}"; shift ;;
		--container) container="${2:-}"; shift ;;
		*) die "未知参数：$1" ;;
		esac
		shift
	done
	[ -n "$dir" ] || dir="$(default_app_dir)"
	case "$dir" in /*) ;; *) die "--dir 必须是绝对路径：$dir" ;; esac
	[ -e "$dir/.env" ] && die "$dir 已经有 .env；直接编辑它，或先备份后删除"
	mkdir -p "$dir"
	set_app "$dir"
	data_dir="${data_dir:-$dir/data}"
	case "$data_dir" in /*) ;; *) die "--data-dir 必须是绝对路径" ;; esac
	mkdir -p "$data_dir" "$dir/workspace"
	uid="${DSH_UID:-$(id -u)}"; gid="${DSH_GID:-$(id -g)}"
	if [ "$uid" = "0" ]; then uid=1000; gid=1000; fi
	[ "$(id -u)" = "0" ] && chown -R "$uid:$gid" "$data_dir" "$dir/workspace" 2>/dev/null || true
	write_compose_file
	write_env_file "$image" "$port" "$bind" "$data_dir" "$uid" "$gid" "" "$container"
	ok "已初始化 $dir"
	info "下一步：编辑 $dir/.env（至少设置 DSH_AUTH_PASSWORD），然后运行："
	info "  dshm --dir $dir docker install"
}

cmd_docker_install() {
	local dir="${APP_DIR:-}" image="${DSHM_IMAGE:-$DEFAULT_IMAGE}" port=3080 bind=127.0.0.1
	local data_dir="" password="" stdin_pw=0 no_pull=0 dry_run=0 uid gid container="${DSHM_CONTAINER:-$DEFAULT_CONTAINER}"
	while [ $# -gt 0 ]; do
		case "$1" in
		--dir | --app-dir) dir="${2:-}"; shift ;;
		--data-dir) data_dir="${2:-}"; shift ;;
		--port) port="${2:-}"; shift ;;
		--bind) bind="${2:-}"; shift ;;
		--image) image="${2:-}"; shift ;;
		--container) container="${2:-}"; shift ;;
		--password-stdin) stdin_pw=1 ;;
		--no-pull) no_pull=1 ;;
		--dry-run) dry_run=1 ;;
		*) die "未知参数：$1" ;;
		esac
		shift
	done

	[ "$dry_run" = "1" ] || require_docker
	[ -n "$dir" ] || dir="$(default_app_dir)"
	case "$dir" in /*) ;; *) die "--dir 必须是绝对路径：$dir" ;; esac
	if [ -e "$dir/.env" ]; then
		set_app "$dir"
		NO_PULL="$no_pull"
		DRY_RUN="$dry_run"
		install_existing
		return 0
	fi
	mkdir -p "$dir"
	set_app "$dir"

	if [ "$stdin_pw" = "1" ]; then
		IFS= read -r password || true
	else
		local p1 p2
		hdr "设置 dsh 登录密码"
		info "至少 14 位；输入不回显"
		read_secret "  密码："
		p1="$SECRET"
		read_secret "  再输一次："
		p2="$SECRET"
		[ "$p1" = "$p2" ] || die "两次输入不一致"
		password="$p1"
	fi
	[ "${#password}" -ge 14 ] || die "密码至少 14 位"
	case "$password" in *$'\n'*) die "密码不能包含换行" ;; esac

	data_dir="${data_dir:-$dir/data}"
	case "$data_dir" in /*) ;; *) die "--data-dir 必须是绝对路径" ;; esac
	mkdir -p "$data_dir" "$dir/workspace"

	uid="${DSH_UID:-$(id -u)}"
	gid="${DSH_GID:-$(id -g)}"
	if [ "$uid" = "0" ]; then
		uid=1000
		gid=1000
		warn "以 root 安装：容器将使用 1000:1000；必要时设置 DSH_UID/DSH_GID"
	fi
	[ "$(id -u)" = "0" ] && chown -R "$uid:$gid" "$data_dir" "$dir/workspace" 2>/dev/null || true

	write_compose_file
	write_env_file "$image" "$port" "$bind" "$data_dir" "$uid" "$gid" "$password" "$container"

	if [ "$dry_run" = "1" ]; then
		ok "dry-run：已生成 $dir/.env 与 $dir/docker-compose.yml（未启动）"
		print_url
		return 0
	fi

	write_state "$image" ""
	remember_app_dir "$dir"

	if [ "$no_pull" != "1" ]; then
		hdr "拉取镜像"
		compose pull || die "镜像拉取失败：$image"
	fi
	hdr "启动 dsh-docker"
	compose up -d || die "docker compose up 失败"
	if ! wait_healthy "$port"; then
		compose logs --tail=80 || true
		die "容器未在预期时间内健康"
	fi
	ok "dsh-docker 已启动"
	hdr "访问地址"
	print_url
	info "实例目录：$dir"
	info "配置：$dir/.env（含密码，权限 600）"
}

# ── 生命周期 ────────────────────────────────────────────────────────────────
cmd_docker_status() {
	require_docker
	require_app
	hdr "dsh-docker 状态"
	compose ps || true
	info "镜像：$(state_get image)"
	info "健康：$(container_health)"
	info "容器：$CONTAINER"
}

cmd_docker_logs() {
	require_docker
	require_app
	compose logs --tail="${1:-100}" --no-follow
}

cmd_docker_up() { require_docker; require_app; compose up -d; }
cmd_docker_down() { require_docker; require_app; compose down; }
cmd_docker_restart() { require_docker; require_app; compose restart; }
cmd_docker_shell() { require_docker; require_app; docker exec -it "$CONTAINER" bash; }

cmd_docker_url() {
	require_app
	print_url
}

# ── 更新 / 回退 ─────────────────────────────────────────────────────────────
image_repo() {
	local image="$1" repo part
	repo="${image##*/}"
	case "$image" in */*) ;; *) repo="$image" ;; esac
	part="${repo##*:}"
	case "$part" in *[!0-9]*) image="${image%:*}" ;; esac
	printf '%s' "$image"
}

cmd_docker_update() {
	local to="" image prev port
	while [ $# -gt 0 ]; do
		case "$1" in
		--to) to="${2:-}"; shift ;;
		*) die "未知参数：$1" ;;
		esac
		shift
	done
	require_docker
	require_app
	prev="$(get_env DSH_IMAGE "$ENV_FILE")"
	[ -n "$prev" ] || die ".env 里没有 DSH_IMAGE"
	if [ -n "$to" ]; then
		case "$to" in
		*/*) image="$to" ;;
		*) image="$(image_repo "$prev"):${to}" ;;
		esac
	else
		image="$(image_repo "$prev"):latest"
	fi
	port="$(get_env DSH_HTTP_PORT "$ENV_FILE")"; port="${port:-3080}"

	hdr "更新 dsh-docker"
	info "$prev"
	info "→ $image"
	compose pull || die "拉取失败，未改配置"
	set_env DSH_IMAGE "$image"
	if ! compose up -d; then
		set_env DSH_IMAGE "$prev"
		die "重建失败，已恢复 $prev"
	fi
	if ! wait_healthy "$port"; then
		warn "新版本不健康，回滚"
		set_env DSH_IMAGE "$prev"
		compose up -d || true
		die "更新失败，已回滚到 $prev"
	fi
	write_state "$image" "$prev"
	ok "已更新到 $image"
}

cmd_docker_rollback() {
	local prev current port
	require_docker
	require_app
	prev="$(state_get previous_image)"
	current="$(state_get image)"
	[ -n "$prev" ] || die "状态文件里没有 previous_image，无法回退"
	port="$(get_env DSH_HTTP_PORT "$ENV_FILE")"; port="${port:-3080}"
	hdr "回退 dsh-docker"
	info "$current"
	info "→ $prev"
	set_env DSH_IMAGE "$prev"
	compose up -d || die "回退启动失败"
	if ! wait_healthy "$port"; then
		die "回退后不健康，请检查：dshm docker logs"
	fi
	write_state "$prev" "$current"
	ok "已回退到 $prev"
}

# ── 配置 ────────────────────────────────────────────────────────────────────
cmd_docker_config() {
	local sub="${1:-show}"
	shift || true
	require_app
	case "$sub" in
	show)
		hdr "配置（$ENV_FILE）"
		grep -v '^DSH_AUTH_PASSWORD=' "$ENV_FILE" | sed 's/^/    /'
		info "DSH_AUTH_PASSWORD=已设置（不显示）"
		;;
	get)
		[ -n "${1:-}" ] || die "用法：dshm docker config get KEY"
		get_env "$1" "$ENV_FILE"
		printf '\n'
		;;
	set)
		[ -n "${1:-}" ] && [ -n "${2:-}" ] || die "用法：dshm docker config set KEY VALUE"
		set_env "$1" "$2"
		ok "已写入 $1；执行 dshm docker up 重建生效"
		;;
	edit)
		"${EDITOR:-vi}" "$ENV_FILE"
		;;
	*) die "未知 config 子命令：$sub" ;;
	esac
}

# ── 认证 ────────────────────────────────────────────────────────────────────
cmd_docker_auth() {
	local sub="${1:-reset}"
	case "$sub" in
	reset)
		require_docker
		require_app
		info "在容器内重置登录密码（交互式）"
		docker exec -it "$CONTAINER" dsh --profile web auth-reset
		;;
	status)
		require_docker
		require_app
		docker exec "$CONTAINER" dsh --profile web auth-reset --help >/dev/null 2>&1 || true
		info "请用 dshm docker auth reset 重置密码"
		;;
	*) die "未知 auth 子命令：$sub" ;;
	esac
}

# ── 诊断 / 卸载 ─────────────────────────────────────────────────────────────
cmd_docker_doctor() {
	require_docker
	require_app
	hdr "dsh-docker 自检"
	info "实例目录：$APP_DIR"
	info "容器：$CONTAINER"
	info "健康：$(container_health)"
	info "镜像：$(state_get image)"
	local port code
	port="$(get_env DSH_HTTP_PORT "$ENV_FILE")"; port="${port:-3080}"
	code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:${port}/login" 2>/dev/null || true)"
	if [ "$code" = "200" ]; then ok "/login = 200"; else warn "/login = ${code:-无响应}"; fi
}

cmd_docker_uninstall() {
	local purge=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--purge) purge=1 ;;
		*) die "未知参数：$1" ;;
		esac
		shift
	done
	require_docker
	require_app
	hdr "卸载 dsh-docker"
	compose down || true
	if [ "$purge" = "1" ]; then
		printf '这会删除 %s（含数据）。输入 DELETE 确认：' "$APP_DIR"
		local answer
		read -r answer
		[ "$answer" = "DELETE" ] || die "已取消"
		rm -rf "$APP_DIR"
		ok "已删除 $APP_DIR"
	else
		ok "容器已停止；数据保留在 $APP_DIR"
		info "彻底删除：dshm docker uninstall --purge"
	fi
}

# ── 自更新 ──────────────────────────────────────────────────────────────────
latest_tag() {
	command -v git >/dev/null 2>&1 || return 1
	git ls-remote --tags --refs "$DSHM_REPO" 2>/dev/null |
		awk -F'refs/tags/' '{print $2}' |
		grep -E '^v[0-9]' |
		sort -V |
		tail -1
}

cmd_self_update() {
	local target="" check=0 force=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--check) check=1 ;;
		--to) target="${2:-}"; shift ;;
		--force | -f) force=1 ;;
		*) die "未知参数：$1" ;;
		esac
		shift
	done
	local cur latest
	cur="$(dshm_version)"
	if [ -z "$target" ]; then
		latest="$(latest_tag || true)"
		[ -n "$latest" ] || die "查不到发布 tag（需要 git 与网络）；可用 --to <tag>"
		target="$latest"
	fi
	case "$target" in v*) ;; *) target="v" ;; esac
	local cur_norm="$cur"
	case "$cur_norm" in v*) cur_norm="${cur_norm#v}" ;; esac
	[ "$check" = "1" ] && { printf '当前：%s\n最新：%s\n' "$cur" "$target"; return 0; }
	if [ "$target" = "v${cur_norm}" ] && [ "$force" != "1" ]; then
		ok "已经是该版本（$cur）"
		return 0
	fi
	command -v curl >/dev/null 2>&1 || die "需要 curl"
	local tmp tgz url sha
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' RETURN
	tgz="$tmp/dshm.tar.gz"
	url="https://github.com/qxdho/deepseek-harness-docker/releases/download/${target}/dshm-${target}.tar.gz"
	info "下载 $url"
	curl -fsSL -o "$tgz" "$url" || die "下载失败"
	sha="$(curl -fsSL --max-time 30 "${url}.sha256" 2>/dev/null | awk 'NR==1{print $1}' || true)"
	if [ -n "$sha" ]; then
		[ "$(sha256sum "$tgz" | awk '{print $1}')" = "$sha" ] || die "sha256 校验失败"
	else
		warn "该版本没有 .sha256，跳过完整性校验"
	fi
	tar -xzf "$tgz" -C "$tmp" || die "解包失败"
	local src="$tmp/dshm-${target}"
	[ -f "$src/dshm" ] || die "发布包缺少 dshm"
	[ -f "$src/scripts/log.sh" ] || die "发布包缺少 scripts"
	[ -f "$src/templates/compose.yaml" ] || die "发布包缺少 templates"
	bash -n "$src/dshm" || die "dshm 语法检查失败"
	install -m 755 "$src/dshm" "$SELF"
	cp -a "$src/scripts/." "$SELF_DIR/scripts/"
	[ -d "$src/templates" ] && cp -a "$src/templates/." "$SELF_DIR/templates/"
	ok "dshm 已更新到 ${target}"
}

# ── 版本 / 帮助 ─────────────────────────────────────────────────────────────
cmd_version() {
	hdr "版本"
	printf '    dshm：%s\n' "$(dshm_version)"
	if [ -n "$APP_DIR" ] && [ -f "$STATE" ]; then
		printf '    镜像：%s\n' "$(state_get image)"
		printf '    容器：%s\n' "$(container_health)"
		local dshv
		dshv="$(docker exec "$CONTAINER" dsh --version 2>/dev/null || true)"
		printf '    容器内 dsh：%s\n' "${dshv:-（容器未运行）}"
	else
		printf '    实例：未安装\n'
	fi
}

show_help() {
	cat <<EOF

dshm — dsh-docker 的独立安装/管理工具

  dshm update [--check] [--to tag]     更新 dshm 自己
  dshm version                         查看 dshm / 镜像 / 容器版本

  dshm docker init [选项]              只生成配置，不启动
      （选项同 install；之后编辑 .env，再 dshm docker install）
  dshm docker install [选项]           安装 dsh-docker
      已有 .env 时按配置安装，不再重新生成
      --dir PATH                       实例目录（默认 /opt/dsh 或 ~/.local/share/dshm/default）
      --data-dir PATH                  数据目录（默认 <实例>/data）
      --port 3080                      宿主端口
      --bind 127.0.0.1                 绑定地址
      --image REPO:TAG                 镜像
      --container NAME                 容器名（默认 qxdho-dsh；迁移验证用 qxdho-dsh-v2）
      --password-stdin                 从标准输入读密码
      --no-pull                        不拉镜像（本地已有）

  dshm docker status|logs|up|down|restart|shell|url
  dshm docker update [--to tag]        更新 dsh-docker
  dshm docker rollback                 回退到上一个镜像
  dshm docker config show|get|set|edit
  dshm docker auth reset               重置登录密码
  dshm docker doctor
  dshm docker uninstall [--purge]

全局：--dir PATH 或 DSHM_APP_DIR=... 指定实例目录。

EOF
}

# ── 入口 ────────────────────────────────────────────────────────────────────
global_dir=""
while [ $# -gt 0 ]; do
	case "$1" in
	--dir | --app-dir)
		global_dir="${2:-}"
		[ -n "$global_dir" ] || die "--dir 需要一个路径"
		shift
		;;
	-h | --help | "")
		show_help
		exit 0
		;;
	*) break ;;
	esac
	shift
done

if [ -n "$global_dir" ]; then
	set_app "$global_dir"
else
	APP_DIR="$(resolve_app_dir)"
	[ -n "$APP_DIR" ] && set_app "$APP_DIR"
fi

cmd="${1:-help}"
shift || true

case "$cmd" in
help) show_help ;;
version) cmd_version ;;
update) cmd_self_update "$@" ;;
docker)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	init) cmd_docker_init "$@" ;;
	install) cmd_docker_install "$@" ;;
	help | -h | --help | "") show_help ;;
	status) cmd_docker_status ;;
	logs) cmd_docker_logs "$@" ;;
	up) cmd_docker_up ;;
	down) cmd_docker_down ;;
	restart) cmd_docker_restart ;;
	shell) cmd_docker_shell ;;
	url) cmd_docker_url ;;
	update) cmd_docker_update "$@" ;;
	rollback) cmd_docker_rollback ;;
	config) cmd_docker_config "$@" ;;
	auth) cmd_docker_auth "$@" ;;
	doctor) cmd_docker_doctor ;;
	uninstall) cmd_docker_uninstall "$@" ;;
	*) die "未知 docker 子命令：$sub" ;;
	esac
	;;
*) die "未知命令：$cmd（运行 dshm help）" ;;
esac
