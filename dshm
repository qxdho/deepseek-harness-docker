# ── 镜像 tag（dsh 容器版本）────────────────────────────────────────────────
#
# 镜像 tag 形如 <dsh版本>-<日期>-<序号>：0.2.0-rc.2-2026.09.30-1
#   * 带 dsh 版本 → 一眼看出镜像里是哪个 dsh
#   * 带日期      → 看出是哪天的构建
#   * 带序号      → 同一天多次构建互不覆盖，旧镜像仍可回退
#
# 为什么必须有序号：tag 一旦被同名覆盖，旧镜像就失去引用、可能被回收，回退就没了。
# 这正是原先那个「纯 dsh 版本 tag」的坑，所以它已被移除。

img_base() {
	# 默认值写在这里（而不是顶层常量）：函数一定在变量赋值之后才被调用，
	# 把默认值放在函数体内就不存在「常量定义没被执行」的风险。
	printf '%s' "${DSH_IMAGE_BASE:-ghcr.io/qxdho/deepseek-harness-docker}"
}

# GHCR 的匿名 pull token（只读，列 tag 不需要登录）
ghcr_token() {
	local img="$1" host repo
	host="${img%%/*}"
	repo="${img#"$host"/}"
	command -v curl >/dev/null 2>&1 || return 1
	curl -fsSL --max-time 15 \
		"https://${host}/token?scope=repository:${repo}:pull&service=${host}" 2>/dev/null |
		awk -F'"' '{for(i=1;i<=NF;i++) if($i=="token"){print $(i+2); exit}}'
}

# 列出该镜像仓库的全部 tag（每行一个）。取不到返回非 0。
# 响应形如 {"name":"...","tags":[...]}：直接按引号切会把 name 也切出来，
# 所以先定位 "tags":[ 这一段再拆。
img_tags() {
	local img token host repo
	img="$(img_base)"
	token="$(ghcr_token "$img")" || return 1
	[ -n "$token" ] || return 1
	host="${img%%/*}"
	repo="${img#"$host"/}"
	curl -fsSL --max-time 20 -H "Authorization: Bearer ${token}" \
		"https://${host}/v2/${repo}/tags/list" 2>/dev/null |
		sed -n 's/.*"tags":\[\(.*\)\]}.*/\1/p' |
		tr ',' '\n' | sed 's/^"//; s/"$//' | grep -v '^$' || true
}

# 当天该 dsh 版本的下一个序号：已有几个 <dsh>-<日期>-* 就 +1
img_next_seq() {
	local dsh="$1" day="$2" n
	n="$(img_tags 2>/dev/null | grep -cE "^${dsh}-${day}-[0-9]+$" || true)"
	[ -n "$n" ] || n=0
	printf '%s' "$((n + 1))"
}

# 构造镜像 tag

# ── dsh 版本管理 ────────────────────────────────────────────────────────────
# npm registry 上的可用版本。解析 JSON 优先用 jq，其次 node / python3 —— 部署机上不一定
# 装了其中哪一个，所以按顺序回退；都没有就给出 npm 查询地址让用户自己看。
DSH_NPM_NAME="@deepseek-ai/dsh"
DSH_NPM_REGISTRY="${DSH_NPM_REGISTRY:-https://registry.npmjs.org}"

dsh_npm_json() {
	command -v curl >/dev/null 2>&1 || return 1
	curl -fsSL --max-time 20 "$DSH_NPM_REGISTRY/$DSH_NPM_NAME" 2>/dev/null
}

# 从 registry JSON 里抽出「每行一个版本，按 semver 升序」
dsh_versions_sorted() {
	local json="$1"
	if command -v jq >/dev/null 2>&1; then
		printf '%s' "$json" | jq -r '.versions | keys[]' 2>/dev/null | sort -V
	elif command -v node >/dev/null 2>&1; then
		printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{Object.keys(JSON.parse(s).versions||{}).forEach(v=>console.log(v))}catch(e){process.exit(1)}})' 2>/dev/null | sort -V
	elif command -v python3 >/dev/null 2>&1; then
		printf '%s' "$json" | python3 -c 'import json,sys;print("\n".join(json.load(sys.stdin).get("versions",{}).keys()))' 2>/dev/null | sort -V
	else
		return 1
	fi
}

dsh_dist_tags() {
	local json="$1"
	if command -v jq >/dev/null 2>&1; then
		printf '%s' "$json" | jq -r '."dist-tags" | to_entries | map("\(.key)=\(.value)") | join("  ")' 2>/dev/null
	elif command -v node >/dev/null 2>&1; then
		printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const t=JSON.parse(s)["dist-tags"]||{};console.log(Object.entries(t).map(([k,v])=>k+"="+v).join("  "))}catch(e){process.exit(1)}})' 2>/dev/null
	elif command -v python3 >/dev/null 2>&1; then
		printf '%s' "$json" | python3 -c 'import json,sys;t=json.load(sys.stdin).get("dist-tags",{});print("  ".join(f"{k}={v}" for k,v in t.items()))' 2>/dev/null
	fi
}

# 当前生效的 dsh 版本：优先问运行中的容器（最准），容器没起就退回 .env / Dockerfile
current_dsh_version() {
	local v=""
	if command -v docker >/dev/null 2>&1 && docker inspect "$CONTAINER" >/dev/null 2>&1; then
		v="$(docker exec "$CONTAINER" dsh --version 2>/dev/null || true)"
	fi
	if [ -z "$v" ]; then
		v="$(env_value_new DSH_VERSION "")"
	fi
	if [ -z "$v" ] && [ -f Dockerfile ]; then
		# 用 awk 而非 grep -oP：BSD/macOS 自带的 grep 没有 -P，而且 grep 无匹配时
		# 返回 1、在 pipefail 下会让整个赋值失败并终止脚本（实测复现）。
		# scripts/update-versions.sh 里已经因为同样的原因改用 awk 了。
		v="$(dockerfile_arg DSH_VERSION)"
	fi
	printf '%s' "$v"
}


# 从 Dockerfile 读一个 ARG 的值。两处都在读 DSH_VERSION，各写一遍迟早漂移
# （其中一处曾用 grep -oP，BSD grep 没有 -P、且无匹配时会因 pipefail 终止脚本）。
# 无匹配或读不到时返回空串，由调用方决定怎么兜底。
dockerfile_arg() {
	awk -F= -v k="ARG $1=" '
		index($0, k) == 1 { v = substr($0, length(k) + 1); gsub(/[ \t\r]/, "", v); print v; exit }
	' Dockerfile 2>/dev/null || true
}
# 该 dsh 版本在 npm 上是否存在（构建前校验，避免打错字等几分钟构建才失败）
dsh_version_exists() {
	local want="$1" json
	json="$(dsh_npm_json)" || return 1
	local all
	all="$(dsh_versions_sorted "$json" 2>/dev/null)" || return 1
	[ -n "$all" ] || return 1
	printf '%s\n' "$all" | grep -qxF "$want"
}

# 该镜像 tag 是否已存在于仓库（拉取前校验）
img_tag_exists() {
	local want="$1"
	img_tags 2>/dev/null | grep -qxF "$want"
}

# 从 npm 解析 dsh 的最新版（dist-tags.latest）。构建镜像前用它把版本 pin 进去，
# 否则 Dockerfile / compose 里的默认值会一直是发布时的旧版本 —— 这是最容易踩的坑：
# 「更新了」但装到的还是老版本。
dsh_latest_version() {
	local json tags
	json="$(dsh_npm_json)" || return 1
	if command -v jq >/dev/null 2>&1; then
		tags="$(printf '%s' "$json" | jq -r '."dist-tags".latest // empty' 2>/dev/null)"
	elif command -v node >/dev/null 2>&1; then
		tags="$(printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(String(JSON.parse(s)["dist-tags"].latest||""))}catch(e){process.exit(1)}})' 2>/dev/null)"
	elif command -v python3 >/dev/null 2>&1; then
		tags="$(printf '%s' "$json" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("dist-tags",{}).get("latest",""))' 2>/dev/null)"
	else
		return 1
	fi
	[ -n "$tags" ] || return 1
	printf '%s' "$tags"
}

show_dsh_versions() {
	local json cur latest tags all total shown
	json="$(dsh_npm_json)" || {
		die "无法访问 $DSH_NPM_REGISTRY（需要网络）；可手动查看：
      $DSH_NPM_REGISTRY/$DSH_NPM_NAME"
	}

	all="$(dsh_versions_sorted "$json")" || die "解析 registry 响应失败（需要 jq、node 或 python3 之一）"
	[ -n "$all" ] || die "registry 响应里没有版本信息"

	cur="$(current_dsh_version)"
	tags="$(dsh_dist_tags "$json")"
	latest="$(printf '%s\n' "$all" | tail -1)"
	total="$(printf '%s\n' "$all" | wc -l | tr -d ' ')"

	# --json：给管理面板（以及任何脚本）用的机器可读输出。走这里而不是让调用方去
	# 解析中文表格 —— 那种解析一改格式就坏。
	# 手写 JSON（不引入 jq 依赖），所以必须转义字符串：版本号理论上来自 registry，
	# 仍然按不可信数据转义，避免一个带引号的版本号把面板的 JSON 解析带崩。
	case "${1:-}" in
	--json)
		local esc esc_latest esc_tags
		esc="$(printf '%s' "$cur" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		# latest 也必须转义：它同样来自 registry，不能直接进 printf 的格式串
		esc_latest="$(printf '%s' "$latest" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		esc_tags="$(printf '%s' "$tags" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		printf '{"current":"%s","latest":"%s","total":%s,"distTags":"%s","versions":[' \
			"$esc" "$esc_latest" "$total" "$esc_tags"
		local first=1 v
		while IFS= read -r v; do
			[ -n "$v" ] || continue
			[ "$first" = "1" ] || printf ','
			first=0
			printf '"%s"' "$(printf '%s' "$v" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		done <<EOF
$all
EOF
		printf ']}\n'
		return 0
		;;
	esac

	hdr "dsh 可用版本"
	# 列表可能很长（本仓库实测 29 个），默认只显示最近 10 个，--all 看全部。
	shown="${DSH_VERSIONS_SHOWN:-10}"
	case "${1:-}" in
	--all | -a) shown="$total" ;;
	esac

	printf '    当前运行：%s\n' "${cur:-未知}"
	printf '    最新版本：%s\n' "$latest"
	printf '    发布标签：%s\n' "${tags:-（无）}"
	printf '    共 %s 个版本' "$total"
	[ "$shown" -lt "$total" ] 2>/dev/null && printf '，下面显示最近 %s 个（--all 看全部）' "$shown"
	printf '\n\n'

	printf '%s\n' "$all" | tail -n "$shown" | while IFS= read -r v; do
		if [ "$v" = "$cur" ]; then
			printf '    %s*%s %s  ← 当前\n' "$GRN" "$RST" "$v"
		elif [ "$v" = "$latest" ]; then
			printf '      %s  ← 最新\n' "$v"
		else
			printf '      %s\n' "$v"
		fi
	done

	printf '\n'
	if [ -n "$cur" ] && [ "$cur" != "$latest" ]; then
		warn "有新版本可用：$cur → $latest"
		info "切换版本需要重建镜像（dsh 在构建期装入）："
		printf '\n      ./dshm version update %s\n\n' "$latest"
		info "或指定任意版本： ./dshm version update <版本>"
	else
		ok "已经是最新版本"
	fi
}

