#!/usr/bin/env bash
# dshm — DSH 部署管理命令（在项目目录里运行：./dshm <命令>）
#
# 命令按分组组织；旧的扁平写法（dshm up / dshm pw …）继续可用。
# 完整说明见 `dshm help`。
#
#   dshm service up|down|restart|status|logs|shell|version|update|url|disk
#   dshm auth    password|user|totp
#   dshm admin   install|uninstall|url|password|status|logs
#   dshm self    install|uninstall
set -euo pipefail

# `./dshm install-self` 会把自己软链到 PATH 里，之后可能以符号链接身份被调用。
# 所以先解析出脚本的真实路径再 cd —— 否则 `dirname "$0"` 会落在符号链接所在的
# 目录（如 /usr/local/bin），后面所有相对路径都会找错地方。
SELF="$0"
while [ -L "$SELF" ]; do
	_link="$(readlink "$SELF")"
	case "$_link" in
	/*) SELF="$_link" ;;
	*) SELF="$(dirname "$SELF")/$_link" ;;
	esac
done
PROJECT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
cd "$PROJECT_DIR"

CLI_NAME=dshm
ENV_FILE=.env
CONTAINER=qxdho-dsh
CLI_IN_CONTAINER=/home/node/.dsh/profiles/web/node_modules/dsh-auth-gate/lib/cli.js

# ── 输出样式 ────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
	B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; RED=$'\033[31m'; YEL=$'\033[33m'; RST=$'\033[0m'
else
	B=; DIM=; GRN=; RED=; YEL=; RST=
fi
hdr() { printf '\n%s==> %s%s\n' "$B" "$*" "$RST"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '    %s✓%s %s\n' "$GRN" "$RST" "$*"; }
die() { printf '\n%s错误：%s%s\n\n' "$RED" "$*" "$RST" >&2; exit 1; }

require_docker() {
	command -v docker >/dev/null 2>&1 || die "未找到 docker"
	docker compose version >/dev/null 2>&1 || die "未找到 docker compose v2"
}
require_env() { [ -f "$ENV_FILE" ] || die "缺少 .env，请先运行 ./install.sh"; }
require_running() {
	docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true \
		|| die "容器 $CONTAINER 没在运行，先执行 ./dshm service up"
}
env_value() {
	local v
	v="$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
	printf '%s' "${v:-$2}"
}
set_env() {
	local key="$1" value="$2" tmp
	tmp="$(mktemp)"
	awk -v k="$key" -v v="$value" 'BEGIN{d=0} $0 ~ "^" k "=" {print k "=" v; d=1; next} {print} END{if(!d) print k "=" v}' "$ENV_FILE" >"$tmp"
	mv "$tmp" "$ENV_FILE"
}

# ── 注册为系统命令 ──────────────────────────────────────────────────────────
warn() { printf '    %s!%s %s\n' "$YEL" "$RST" "$*"; }
is_root() { [ "$(id -u)" = "0" ]; }

# 放系统命令的目录：优先 /usr/local/bin（可写 / root / 免密 sudo），否则 ~/.local/bin。
# 只认免密 sudo，避免 `sudo -n false` 时卡在密码提示上。
cli_dir() {
	if [ -w /usr/local/bin ] 2>/dev/null || is_root; then
		printf '%s' /usr/local/bin
	elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
		printf '%s' /usr/local/bin
	else
		printf '%s' "${HOME}/.local/bin"
	fi
}

install_self() {
	hdr "把 dshm 注册为系统命令"
	local dir target
	dir="$(cli_dir)"
	target="$dir/$CLI_NAME"
	chmod +x "$PROJECT_DIR/$CLI_NAME" 2>/dev/null || true
	# 先把目录建出来（~/.local/bin 通常还不存在），再判断可写性
	if ! mkdir -p "$dir" 2>/dev/null; then
		if command -v sudo >/dev/null 2>&1; then
			sudo mkdir -p "$dir" || die "无法创建 $dir"
		else
			die "无法创建 $dir（需要 root 或 sudo）"
		fi
	fi
	if [ -w "$dir" ] || is_root; then
		ln -sfn "$PROJECT_DIR/$CLI_NAME" "$target"
	elif command -v sudo >/dev/null 2>&1; then
		sudo ln -sfn "$PROJECT_DIR/$CLI_NAME" "$target"
	else
		die "无法写入 $dir（需要 root、可写的目标目录，或已安装 sudo）"
	fi
	[ -L "$target" ] || die "创建链接失败：$target"
	ok "已注册：${target} -> ${PROJECT_DIR}/${CLI_NAME}"
	case ":$PATH:" in
	*":$dir:"*)
		info "现在可在任意目录直接运行： dshm status"
		;;
	*)
		warn "$dir 不在 PATH 中，把下面一行加到 ~/.bashrc 或 ~/.zshrc："
		printf '\n    export PATH="%s:$PATH"\n\n' "$dir"
		;;
	esac
}

uninstall_self() {
	hdr "移除系统命令"
	local dir target found=0
	for dir in /usr/local/bin "${HOME}/.local/bin"; do
		target="$dir/$CLI_NAME"
		[ -L "$target" ] || continue
		found=1
		if [ -w "$dir" ] 2>/dev/null || is_root; then
			rm -f "$target"
		elif command -v sudo >/dev/null 2>&1; then
			sudo rm -f "$target"
		else
			warn "无法移除 $target（权限不足）"
			continue
		fi
		ok "已移除 $target"
	done
	[ "$found" = "1" ] || info "没有找到注册的符号链接（可能未安装过）"
}

# ── 隐藏输入 + 星号回显 ─────────────────────────────────────────────────────
# 用法：read_secret "提示文字"  → 结果在变量 SECRET 里
SECRET=""
read_secret() {
	local prompt="$1" ch
	SECRET=""
	printf '%s' "$prompt"
	if [ ! -t 0 ]; then
		IFS= read -rs SECRET || true
		printf '\n'
		return
	fi
	while IFS= read -rs -n1 ch; do
		case "$ch" in "" | $'\n' | $'\r') break ;; esac
		if [ "$ch" = $'\x7f' ] || [ "$ch" = $'\b' ]; then
			if [ -n "$SECRET" ]; then
				SECRET="${SECRET%?}"
				printf '\b \b'
			fi
			continue
		fi
		SECRET+="$ch"
		printf '*'
	done
	SECRET="${SECRET%$'\r'}"
	printf '\n'
}

# 密码合规检查（与 dsh-auth-gate 的策略一致）
check_password() {
	local pw="$1" missing=""
	[ "${#pw}" -ge 14 ] || missing="${missing} 至少14位;"
	printf '%s' "$pw" | grep -q '[A-Z]' || missing="${missing} 大写字母;"
	printf '%s' "$pw" | grep -q '[a-z]' || missing="${missing} 小写字母;"
	printf '%s' "$pw" | grep -q '[0-9]' || missing="${missing} 数字;"
	printf '%s' "$pw" | grep -q '[^A-Za-z0-9]' || missing="${missing} 特殊符号;"
	[ -z "$missing" ] || die "密码不合规，缺少：${missing}"
}

PASSWORD=""
ask_new_password() {
	local p1 p2
	while :; do
		read_secret "  新密码（≥14位，含大写/小写/数字/符号）："
		p1="$SECRET"
		read_secret "  再输一次确认："
		p2="$SECRET"
		# 非交互模式（管道）下 stdin 耗尽会一直读到空串，p1 != p2 永远成立 →
		# 无限循环。检测到空输入直接报错，别让调用方挂住。
		if [ ! -t 0 ] && { [ -z "$p1" ] || [ -z "$p2" ]; }; then
			die "非交互模式下读取密码失败（输入为空或已到 EOF）；改密码请交互执行 ./dshm auth password"
		fi
		if [ "$p1" != "$p2" ]; then
			printf '  %s两次输入不一致，请重新输入%s\n' "$YEL" "$RST"
			continue
		fi
		check_password "$p1"
		PASSWORD="$p1"
		return
	done
}

wait_healthy() {
	local status elapsed=0 last=-10
	for _ in $(seq 1 72); do
		status="$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null || echo unknown)"
		[ "$status" = "healthy" ] && return 0

		# 容器已经退出/在重启循环里，就没必要再空等下去 —— 直接把日志尾部打出来。
		# 原来是闷头等满 6 分钟才报「未健康」，最气人的是还不说为什么。
		case "$status" in
		exited | dead | restarting | unknown)
			printf '    %s容器状态异常（%s），不再等待%s\n' "$YEL" "$status" "$RST"
			docker logs --tail 40 "$CONTAINER" 2>&1 || true
			return 1
			;;
		esac

		# 每 10 秒给一行进度，否则用户完全不知道在等什么。
		if [ $((elapsed - last)) -ge 10 ]; then
			printf '    %s等待就绪… %ss（%s）%s\n' "$DIM" "$elapsed" "$status" "$RST"
			last="$elapsed"
		fi
		sleep 5
		elapsed=$((elapsed + 5))
	done
	printf '    %s容器未在预期时间内健康（当前：%s）%s\n' "$YEL" "$status" "$RST"
	docker logs --tail 40 "$CONTAINER" 2>&1 || true
	return 1
}

# ── 帮助 ────────────────────────────────────────────────────────────────────
help_service() {
	cat <<EOF

${B}服务${RST} — 管理 dsh 容器
  dshm service up [--build]      启动 / 应用 .env 改动
  dshm service down              停止（数据保留）
  dshm service restart           重启（重读 .env 并重建）
  dshm service status            健康 / 端口 / 登录用户
  dshm service logs              日志
  dshm service shell             进容器
  dshm service version           容器内 dsh 版本
  dshm service update [版本]      升级 dsh（重建镜像）
  dshm service url               一次性 launch URL（排障）
  dshm service disk              磁盘占用 / 清理命令
EOF
}

help_auth() {
	cat <<EOF

${B}登录${RST} — 密码与账号
  dshm auth password [用户]      改登录密码（默认 $(env_value DSH_AUTH_USER admin)）
  dshm auth user list            列出登录用户
  dshm auth user add 名字        新建用户 [--admin]
  dshm auth user disable 名字    禁用用户
  dshm auth totp enable [用户]    开启两步验证
  dshm auth totp disable [用户]
EOF
}

help_self() {
	cat <<EOF

${B}自身${RST}
  dshm self install             把 dshm 注册为系统命令（之后任意目录可直接 dshm …）
  dshm self uninstall           移除系统命令
EOF
}

show_help() {
	case "${1:-}" in
	service | svc) help_service; return ;;
	auth | login) help_auth; return ;;
	self | cli) help_self; return ;;
	admin | panel)
		# shellcheck source=scripts/admin.sh
		. ./scripts/admin.sh
		admin_help
		return
		;;
	esac
	cat <<EOF

${B}dshm${RST} — DSH 部署管理命令（在当前目录运行）

用法：${B}dshm <分组> <子命令> [参数]${RST}
EOF
	help_service
	help_auth
	cat <<EOF

${B}面板${RST}
  dshm admin install            安装管理面板（宿主 / 容器二选一）
  dshm admin url|password|status|logs|uninstall
  dshm admin help               面板详细说明
EOF
	help_self
	cat <<EOF

${DIM}旧写法（up / down / restart / status / logs / pw / user / totp / disk / url /
install-self …）仍然可用。分组帮助：dshm service|auth|admin|self help
改运行配置：编辑 .env 后执行 dshm service up${RST}

EOF
}

cmd="${1:-help}"
shift || true

# ── 命令归一化 ──────────────────────────────────────────────────────────────
# 对外主推分组写法 `dshm <分组> <子命令>`，同时把旧的扁平写法
# （dshm up / dshm pw / dshm user add …）继续映射到同一批内部命令，
# 这样已有脚本、文档、肌肉记忆都不会断。分组只做一次翻译，真正的实现仍在
# 下面那个 case 里，避免逻辑分裂成两份。
case "$cmd" in
svc | service)
	sub="${1:-help}"
	shift || true
	if [ "$sub" = "help" ] || [ "$sub" = "-h" ] || [ "$sub" = "--help" ]; then
		cmd=help
		set -- service
	else
		cmd="$sub"
	fi
	;;
login | auth)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	password | passwd | pw) cmd=pw ;;
	user) cmd=user ;;
	totp) cmd=totp ;;
	help | -h | --help | "") cmd=help; set -- auth ;;
	*) die "未知子命令：auth $sub（运行 dshm help）" ;;
	esac
	;;
cli | self)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	install) cmd=install-self ;;
	uninstall) cmd=uninstall-self ;;
	help | -h | --help | "") cmd=help; set -- self ;;
	*) die "未知子命令：self $sub（运行 dshm help）" ;;
	esac
	;;
panel | admin)
	# shellcheck source=scripts/admin.sh
	. ./scripts/admin.sh
	admin_dispatch "$@"
	exit $?
	;;
esac

case "$cmd" in
up)
	require_docker; require_env
	if [ "${1:-}" = "--build" ]; then
		hdr "本地构建镜像"
		docker compose build
	fi
	# 工作区预检：/workspace 是 bind mount，属主不对的话容器里的 agent 写不进去。
	# 必须在 compose up 之前跑 —— 源目录被 dockerd 自动创建时属主是 root。
	hdr "准备工作区"
	# shellcheck source=scripts/preflight.sh
	. ./scripts/preflight.sh
	if ! check_workspace "$PWD" auto 1; then
		die "工作区未就绪，请按上面的提示处理后重试"
	fi
	ok "工作区就绪：${DSH_WORKSPACE_DIR}"
	hdr "启动服务"
	docker compose up -d
	hdr "等待健康检查"
	if wait_healthy; then
		bind="$(env_value DSH_BIND 127.0.0.1)"
		port="$(env_value PROXY_PORT 3080)"
		ok "服务已就绪"
		if [ "$bind" = "0.0.0.0" ]; then
			info "访问地址：http://<服务器IP>:${port}/"
		else
			info "只绑定了 127.0.0.1，请在宿主机反代到 127.0.0.1:${port}"
		fi
	else
		# 不加 else 的话，失败时这个 if 返回 0，整个 ./dshm up 会以成功退出 ——
		# 脚本化调用会把「起不来」当成「已就绪」。
		die "容器未在预期时间内健康，请查看 ./dshm service logs"
	fi
	;;

down)
	require_docker
	hdr "停止服务（数据保留）"
	docker compose down
	ok "已停止"
	;;

restart)
	require_docker
	hdr "重启服务（会重新读取 .env）"
	# 用 `up -d` 而不是 `docker compose restart`：后者只是把现有容器里的进程重启，
	# **不会**重读 .env，也不会因 compose 配置变化而重建容器。也就是说改了
	# DSH_UID / DSH_WORKSPACE / 端口之后 `restart` 看着成功了、实际毫无变化。
	# `up -d` 会按当前 .env 重建有变化的容器，符合「重启使新配置生效」的直觉；
	# 配置没变时它等价于什么都不做（已是最新）。
	docker compose up -d
	wait_healthy || die "容器未在预期时间内健康，请查看 ./dshm service logs"
	ok "已重启并健康"
	;;

logs)
	require_docker
	docker compose logs -f --tail 100
	;;

status)
	require_docker
	hdr "服务状态"
	state="$(docker inspect --format '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo missing)"
	health="$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null || echo -)"
	restarts="$(docker inspect --format '{{.RestartCount}}' "$CONTAINER" 2>/dev/null || echo -)"
	info "状态：${state}    健康：${health}    重启次数：${restarts}"
	info "端口：$(env_value DSH_BIND 127.0.0.1):$(env_value PROXY_PORT 3080) -> 容器 3080"
	info "登录用户：$(env_value DSH_AUTH_USER admin)"
	info "入口：http://<服务器IP>:$(env_value PROXY_PORT 3080)/"
	;;

disk | df)
	require_docker
	hdr "磁盘占用"
	info "宿主："
	df -h / 2>/dev/null | sed 's/^/    /' || true
	if docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
		info "容器内 /home/node/.dsh 所在卷："
		docker exec "$CONTAINER" df -h /home/node/.dsh 2>/dev/null | sed 's/^/    /' || true
		info "占用最大的目录："
		docker exec "$CONTAINER" sh -c \
			'du -xh /home/node/.dsh --max-depth=2 2>/dev/null | sort -h | tail -10' | sed 's/^/    /' || true
		info "npm 缓存：$(docker exec "$CONTAINER" sh -c 'du -sh /tmp/npm-cache 2>/dev/null | cut -f1' 2>/dev/null || true)"
	else
		info "容器未运行，只显示宿主磁盘。"
	fi
	info "清理："
	info "  docker exec $CONTAINER rm -rf /home/node/.dsh/.npm /tmp/npm-cache"
	info "  docker image prune -a && docker builder prune"
	;;

url)
	require_docker; require_running
	hdr "一次性 launch URL（排障用）"
	docker exec "$CONTAINER" cat /home/node/.dsh/web-launch-url.txt 2>/dev/null || info "（暂无）"
	;;

shell)
	require_docker; require_running
	hdr "进入容器（输入 exit 退出）"
	docker exec -it "$CONTAINER" bash
	;;

pw | passwd | password)
	require_docker; require_running
	user="${1:-$(env_value DSH_AUTH_USER admin)}"
	hdr "修改登录密码"
	info "用户：${B}${user}${RST}"
	info "规则：至少 14 位，且包含大写 / 小写 / 数字 / 特殊符号"
	ask_new_password
	# 插件的 user passwd --password-stdin 在管道模式下读两行（密码 + 确认），
	# 只喂一行会报 "passwords do not match"，所以这里喂两行。
	if printf '%s\n%s\n' "$PASSWORD" "$PASSWORD" \
		| docker exec -i -e DSH_HOME=/home/node/.dsh "$CONTAINER" node "$CLI_IN_CONTAINER" \
			user passwd "$user" --password-stdin; then
		ok "密码已更新"
	else
		die "修改失败：请看上面的错误信息（常见原因：用户不存在 / 新密码与旧密码相同 / 密码不合规）"
	fi
	;;

user)
	require_docker; require_running
	sub="${1:-list}"; shift || true
	case "$sub" in
	list | ls)
		hdr "登录用户列表"
		docker exec -e DSH_HOME=/home/node/.dsh "$CONTAINER" node "$CLI_IN_CONTAINER" user list
		;;
	add)
		[ -n "${1:-}" ] || die "用法：./dshm auth user add <用户名> [--admin]"
		name="$1"; shift || true
		hdr "新建用户：${name}"
		extra=""
		for a in "$@"; do
			case "$a" in --admin | --disabled) extra="$extra $a" ;; esac
		done
		ask_new_password
		# shellcheck disable=SC2086
		if printf '%s\n' "$PASSWORD" \
			| docker exec -i -e DSH_HOME=/home/node/.dsh "$CONTAINER" node "$CLI_IN_CONTAINER" \
				user add "$name" --password-stdin $extra; then
			ok "用户 ${name} 已创建"
		else
			die "创建失败（用户名或密码不符合要求）"
		fi
		;;
	disable)
		[ -n "${1:-}" ] || die "用法：./dshm auth user disable <用户名>"
		hdr "禁用用户：${1}"
		docker exec -e DSH_HOME=/home/node/.dsh "$CONTAINER" node "$CLI_IN_CONTAINER" user disable "$1"
		ok "已禁用（并吊销其会话）"
		;;
	*)
		die "未知子命令：user $sub（支持 list / add / disable）"
		;;
	esac
	;;

totp)
	require_docker; require_running
	action="${1:-}"; shift || true
	case "$action" in enable | disable) ;; *) die "用法：./dshm auth totp <enable|disable> [用户名]" ;; esac
	user="${1:-$(env_value DSH_AUTH_USER admin)}"
	hdr "两步验证 ${action}：用户 ${user}"
	docker exec -e DSH_HOME=/home/node/.dsh "$CONTAINER" node "$CLI_IN_CONTAINER" user totp "$action" "$user"
	;;

update)
	require_docker; require_env
	target="${1:-}"
	if [ -z "$target" ]; then
		command -v npm >/dev/null 2>&1 || die "本机没有 npm，无法自动取版本；请显式指定：./dshm update <版本>"
		# npm 的 latest 标签可能比仓库内置的更新版更旧（预发布版常挂在 next 上），
		# 所以取「已发布版本里最新的那个」，而不是 dist-tags.latest。
		target="$(npm view @deepseek-ai/dsh versions --json 2>/dev/null \
			| tr -d '[]" ' | tr ',' '\n' | grep . | sort -V | tail -n1)"
		[ -n "$target" ] || die "无法解析最新版本，请显式指定：./dshm update <版本>"
		info "自动选中最新已发布版本：${target}（要指定版本：./dshm update <版本>）"
	fi
	hdr "升级 dsh 到 ${target}"
	info "当前版本：$(env_value DSH_VERSION) -> ${target}"
	set_env DSH_VERSION "$target"
	docker compose build
	docker compose up -d
	wait_healthy && ok "已升级到 ${target}"
	;;

version)
	require_docker; require_running
	hdr "容器内 dsh 版本"
	docker exec "$CONTAINER" dsh --version
	;;

install-self | link | install-cli)
	install_self
	;;

uninstall-self | unlink)
	uninstall_self
	;;

help | -h | --help | "")
	show_help "$@"
	;;

*)
	die "未知命令：${cmd}（运行 dshm help 查看帮助）"
	;;
esac
