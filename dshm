#!/usr/bin/env bash
# dshm — DSH 部署管理命令（在项目目录里运行：./dshm <命令>）
#
# 命令按分组组织；旧的扁平写法（dshm up / dshm pw …）继续可用。
# 完整说明见 `dshm help`。
#
#   dshm service up|down|restart|status|logs|shell|version|update|url|disk
#   dshm auth    password|user|totp
#   dshm admin   install|uninstall|url|password|status|logs
#   dshm self    install|uninstall
set -euo pipefail

# `./dshm install-self` 会把自己软链到 PATH 里，之后可能以符号链接身份被调用。
# 所以先解析出脚本的真实路径再 cd —— 否则 `dirname "$0"` 会落在符号链接所在的
# 目录（如 /usr/local/bin），后面所有相对路径都会找错地方。
SELF="$0"
while [ -L "$SELF" ]; do
	_link="$(readlink "$SELF")"
	case "$_link" in
	/*) SELF="$_link" ;;
	*) SELF="$(dirname "$SELF")/$_link" ;;
	esac
done
PROJECT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
cd "$PROJECT_DIR"

CLI_NAME=dshm
ENV_FILE=.env
CONTAINER=qxdho-dsh
dsh_home_in_container() { env_value_new DSH_HOME_CONTAINER /dsh; }
dsh_home_host() { env_value DSH_HOME_HOST /dsh; }
cli_in_container() { printf "%s/profiles/web/node_modules/dsh-auth-gate/lib/cli.js" "$(dsh_home_in_container)"; }

# ── 输出样式 ────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
	B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; RED=$'\033[31m'; YEL=$'\033[33m'; RST=$'\033[0m'
else
	B=; DIM=; GRN=; RED=; YEL=; RST=
fi
hdr() { printf '\n%s==> %s%s\n' "$B" "$*" "$RST"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '    %s✓%s %s\n' "$GRN" "$RST" "$*"; }
die() { printf '\n%s错误：%s%s\n\n' "$RED" "$*" "$RST" >&2; exit 1; }

require_docker() {
	command -v docker >/dev/null 2>&1 || die "未找到 docker"
	docker compose version >/dev/null 2>&1 || die "未找到 docker compose v2"
}
require_env() { [ -f "$ENV_FILE" ] || die "缺少 .env，请先运行 ./install.sh"; }
require_running() {
	docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true \
		|| die "容器 $CONTAINER 没在运行，先执行 ./dshm service up"
}
# .env 的读写统一走 lib，和 install.sh 共用一份实现，避免两套解析器慢慢跑偏。
# shellcheck source=scripts/env-config.sh
. ./scripts/env-config.sh
# 旧命名卷 → 宿主目录的搬迁同样共用一份实现（install.sh 也会 source 它）
# shellcheck source=scripts/migrate-home.sh
. ./scripts/migrate-home.sh

# ── 注册为系统命令 ──────────────────────────────────────────────────────────
warn() { printf '    %s!%s %s\n' "$YEL" "$RST" "$*"; }
is_root() { [ "$(id -u)" = "0" ]; }

# dshm 自身从哪更新。可用 DSHM_REPO 覆盖（fork 或内网镜像）。
DSHM_REPO_URL="${DSHM_REPO:-https://github.com/qxdho/deepseek-harness-docker}"
DSHM_RAW_BASE="${DSHM_RAW_BASE:-https://raw.githubusercontent.com/qxdho/deepseek-harness-docker/main}"

# 放系统命令的目录：优先 /usr/local/bin（可写 / root / 免密 sudo），否则 ~/.local/bin。
# 只认免密 sudo，避免 `sudo -n false` 时卡在密码提示上。
cli_dir() {
	if [ -w /usr/local/bin ] 2>/dev/null || is_root; then
		printf '%s' /usr/local/bin
	elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
		printf '%s' /usr/local/bin
	else
		printf '%s' "${HOME}/.local/bin"
	fi
}

install_self() {
	hdr "把 dshm 注册为系统命令"
	local dir target
	dir="$(cli_dir)"
	target="$dir/$CLI_NAME"
	chmod +x "$PROJECT_DIR/$CLI_NAME" 2>/dev/null || true
	# 先把目录建出来（~/.local/bin 通常还不存在），再判断可写性
	if ! mkdir -p "$dir" 2>/dev/null; then
		if command -v sudo >/dev/null 2>&1; then
			sudo mkdir -p "$dir" || die "无法创建 $dir"
		else
			die "无法创建 $dir（需要 root 或 sudo）"
		fi
	fi
	if [ -w "$dir" ] || is_root; then
		ln -sfn "$PROJECT_DIR/$CLI_NAME" "$target"
	elif command -v sudo >/dev/null 2>&1; then
		sudo ln -sfn "$PROJECT_DIR/$CLI_NAME" "$target"
	else
		die "无法写入 $dir（需要 root、可写的目标目录，或已安装 sudo）"
	fi
	[ -L "$target" ] || die "创建链接失败：$target"
	ok "已注册：${target} -> ${PROJECT_DIR}/${CLI_NAME}"
	case ":$PATH:" in
	*":$dir:"*)
		info "现在可在任意目录直接运行： dshm status"
		;;
	*)
		warn "$dir 不在 PATH 中，把下面一行加到 ~/.bashrc 或 ~/.zshrc："
		printf '\n    export PATH="%s:$PATH"\n\n' "$dir"
		;;
	esac
}

uninstall_self() {
	hdr "移除系统命令"
	local dir target found=0
	for dir in /usr/local/bin "${HOME}/.local/bin"; do
		target="$dir/$CLI_NAME"
		[ -L "$target" ] || continue
		found=1
		if [ -w "$dir" ] 2>/dev/null || is_root; then
			rm -f "$target"
		elif command -v sudo >/dev/null 2>&1; then
			sudo rm -f "$target"
		else
			warn "无法移除 $target（权限不足）"
			continue
		fi
		ok "已移除 $target"
	done
	[ "$found" = "1" ] || info "没有找到注册的符号链接（可能未安装过）"
}

# ── dshm 自更新 ─────────────────────────────────────────────────────────────
# 从仓库拉取最新的 dshm 覆盖自身。适用场景：只装了 dshm（或已把它注册为系统命令），
# 没保留 git 仓库 / 不想 git pull 的部署机。
#
# 安全和健壮性上做了几件事：
#   1. 先下载到临时文件、`bash -n` 语法检查，再替换 —— 中途断网不会留下半截脚本。
#   2. 替换走「同目录内 mv」（原子），不是直接写目标文件。
#   3. 内容相同就跳过（用 sha256 比对），带 --force 才强制重写。
#   4. 保留原文件的权限位，脚本仍可执行。
self_update() {
	hdr "更新 dshm 自身"
	local force=0 allow_stale=0
	for a in "$@"; do
		case "$a" in
		--force | -f) force=1 ;;
		--allow-stale) allow_stale=1 ;;
		*) die "未知参数：$a（用法：./dshm self update [--force] [--allow-stale]）" ;;
		esac
	done

	command -v curl >/dev/null 2>&1 || die "需要 curl 才能自更新（或改用 git pull）"

	# 在 git 工作区里跑时提醒一句：这份文件的权威来源是仓库，自更新会覆盖本地改动。
	# 并顺手用 ls-remote 查一下**本地 clone 是否落后于远端 main** —— 这是最容易踩的坑：
	# clone 之后忘了 git pull，本地就是旧脚本，单看文件内容看不出来。
	if [ -d "$PROJECT_DIR/.git" ] && command -v git >/dev/null 2>&1; then
		warn "当前目录是 git 工作区，推荐用 git pull 更新；self update 会覆盖本地对 dshm 的改动"
		local remote_sha local_sha
		remote_sha="$(timeout 15 git ls-remote "$DSHM_REPO_URL" refs/heads/main 2>/dev/null | cut -f1)"
		local_sha="$(git -C "$PROJECT_DIR" rev-parse HEAD 2>/dev/null || true)"
		if [ -n "$remote_sha" ] && [ -n "$local_sha" ]; then
			if [ "$remote_sha" = "$local_sha" ]; then
				if [ "$force" != "1" ]; then
					ok "本地仓库已与远端 main 一致（${local_sha%"${local_sha#???????}"}）"
					info "如确实要重新下载，加 --force"
					return 0
				fi
			else
				warn "本地仓库落后于远端 main："
				printf '        本地 %s\n        远端 %s\n' "${local_sha%"${local_sha#???????}"}" "${remote_sha%"${remote_sha#???????}"}"
				info "建议先 git pull；若继续，self update 会拉取远端最新版"
				if [ "$allow_stale" != "1" ]; then
					die "已停下以免覆盖你的本地改动。
      确认要继续（用远端覆盖本地 dshm）：./dshm self update --allow-stale"
				fi
			fi
		fi
	fi

	local url="$DSHM_RAW_BASE/$CLI_NAME"
	local tmp
	tmp="$(mktemp "${TMPDIR:-/tmp}/dshm.XXXXXX")"

	info "下载 $url"
	if ! curl -fsSL -o "$tmp" "$url"; then
		rm -f "$tmp"
		die "下载失败：$url
      检查网络，或确认分支名（默认 main）；也可用 DSHM_RAW_BASE 指向镜像：
        DSHM_RAW_BASE=https://你的镜像/dshm ./dshm self update"
	fi

	# 语法自检：宁可继续用旧版本，也不能换成跑不起来的脚本
	if ! bash -n "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		die "下载到的 dshm 未通过语法检查，已放弃替换（原文件未改动）"
	fi

	# 内容自检：确认下到的确实是本项目脚本，而不是错误页 / 代理返回的 HTML。
	# 只看一个稳定特征串（命令列表里一定有 self），缺失就拒绝。
	if ! grep -q 'dshm self' "$tmp"; then
		rm -f "$tmp"
		die "下载到的内容不像 dshm（缺少预期特征），已放弃替换。检查 DSHM_RAW_BASE 是否指向正确文件"
	fi

	local cur="$PROJECT_DIR/$CLI_NAME"
	if [ "$force" != "1" ] && [ -f "$cur" ] \
		&& [ "$(sha256sum "$cur" 2>/dev/null | cut -d' ' -f1)" = "$(sha256sum "$tmp" 2>/dev/null | cut -d' ' -f1)" ]; then
		ok "已经是最新版本，无需更新"
		return 0
	fi

	local mode
	mode="$(stat -c '%a' "$cur" 2>/dev/null || echo 755)"
	if [ -w "$cur" ] || [ -w "$PROJECT_DIR" ]; then
		install -m "$mode" "$tmp" "$cur"
	elif command -v sudo >/dev/null 2>&1; then
		sudo install -m "$mode" "$tmp" "$cur"
	else
		die "无法写入 $cur（需要它可写，或用 sudo）"
	fi
	if [ -x "$cur" ]; then
		ok "已更新：$cur"
	else
		chmod +x "$cur" 2>/dev/null || true
		ok "已更新：$cur（已补可执行位）"
	fi
	info "仓库：$DSHM_REPO_URL"
}

# ── 密码合规检查 ────────────────────────────────────────────────────────────
# 规则本身写在 scripts/env-config.sh 的 env_validate_password 里（install.sh 也用
# 那一份），这里只把「不合规」从「返回 1」翻译成「直接退出」。
check_password() {
	env_validate_password "$1" || die "密码不合规（至少 14 位，且含大写/小写/数字/特殊符号）"
}

PASSWORD=""
ask_new_password() {
	local p1 p2
	while :; do
		read_secret "  新密码（≥14位，含大写/小写/数字/符号）："
		p1="$SECRET"
		read_secret "  再输一次确认："
		p2="$SECRET"
		# 非交互模式（管道）下 stdin 耗尽会一直读到空串，p1 != p2 永远成立 →
		# 无限循环。检测到空输入直接报错，别让调用方挂住。
		if [ ! -t 0 ] && { [ -z "$p1" ] || [ -z "$p2" ]; }; then
			die "非交互模式下读取密码失败（输入为空或已到 EOF）；改密码请交互执行 ./dshm auth password"
		fi
		if [ "$p1" != "$p2" ]; then
			printf '  %s两次输入不一致，请重新输入%s\n' "$YEL" "$RST"
			continue
		fi
		check_password "$p1"
		PASSWORD="$p1"
		return
	done
}

# 等待容器健康。实现放在 scripts/env-config.sh，install.sh 共用同一份 —— 此前
# 两处各写一遍、语义已经漂移（install.sh 那版在 docker inspect 首次失败时就退出，
# 会把容器刚创建时的瞬时错误误判成启动失败）。
wait_healthy() {
	wait_container_healthy "$CONTAINER" "docker logs --tail 40 $CONTAINER"
}

# 启动/重建前的统一准备：旧键改名 + 对齐默认值 + 目录属主预检。
# up 和 restart 都要走这一步 —— 否则改了 DSH_WORKSPACE_HOST 之后直接重建容器，
# dockerd 会把源目录建 root 属主，容器里写不进去，只能靠降级悄悄跑。
prepare_workspace() {
	migrate_legacy_keys
	normalize_defaults
	# 旧版数据在命名卷里：目标目录还是空的就先自动搬过来，否则新版起来会
	# 「看起来像全新安装」。只在这一次会真正动手，之后目标非空即跳过。
	auto_migrate_legacy_home
	hdr "准备工作区"
	# shellcheck source=scripts/preflight.sh
	. ./scripts/preflight.sh
	if ! check_workspace "$PWD" auto 1; then
		die "工作区未就绪，请按上面的提示处理后重试"
	fi
	ok "工作区就绪：${DSH_WORKSPACE_DIR}"
}

# ── dsh 版本管理 ────────────────────────────────────────────────────────────
# npm registry 上的可用版本。解析 JSON 优先用 jq，其次 node / python3 —— 部署机上不一定
# 装了其中哪一个，所以按顺序回退；都没有就给出 npm 查询地址让用户自己看。
DSH_NPM_NAME="@deepseek-ai/dsh"
DSH_NPM_REGISTRY="${DSH_NPM_REGISTRY:-https://registry.npmjs.org}"

dsh_npm_json() {
	command -v curl >/dev/null 2>&1 || return 1
	curl -fsSL --max-time 20 "$DSH_NPM_REGISTRY/$DSH_NPM_NAME" 2>/dev/null
}

# 从 registry JSON 里抽出「每行一个版本，按 semver 升序」
dsh_versions_sorted() {
	local json="$1"
	if command -v jq >/dev/null 2>&1; then
		printf '%s' "$json" | jq -r '.versions | keys[]' 2>/dev/null | sort -V
	elif command -v node >/dev/null 2>&1; then
		printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{Object.keys(JSON.parse(s).versions||{}).forEach(v=>console.log(v))}catch(e){process.exit(1)}})' 2>/dev/null | sort -V
	elif command -v python3 >/dev/null 2>&1; then
		printf '%s' "$json" | python3 -c 'import json,sys;print("\n".join(json.load(sys.stdin).get("versions",{}).keys()))' 2>/dev/null | sort -V
	else
		return 1
	fi
}

dsh_dist_tags() {
	local json="$1"
	if command -v jq >/dev/null 2>&1; then
		printf '%s' "$json" | jq -r '."dist-tags" | to_entries | map("\(.key)=\(.value)") | join("  ")' 2>/dev/null
	elif command -v node >/dev/null 2>&1; then
		printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const t=JSON.parse(s)["dist-tags"]||{};console.log(Object.entries(t).map(([k,v])=>k+"="+v).join("  "))}catch(e){process.exit(1)}})' 2>/dev/null
	elif command -v python3 >/dev/null 2>&1; then
		printf '%s' "$json" | python3 -c 'import json,sys;t=json.load(sys.stdin).get("dist-tags",{});print("  ".join(f"{k}={v}" for k,v in t.items()))' 2>/dev/null
	fi
}

# 当前生效的 dsh 版本：优先问运行中的容器（最准），容器没起就退回 .env / Dockerfile
current_dsh_version() {
	local v=""
	if command -v docker >/dev/null 2>&1 && docker inspect "$CONTAINER" >/dev/null 2>&1; then
		v="$(docker exec "$CONTAINER" dsh --version 2>/dev/null || true)"
	fi
	if [ -z "$v" ]; then
		v="$(env_value_new DSH_VERSION "")"
	fi
	if [ -z "$v" ] && [ -f Dockerfile ]; then
		v="$(grep -oP 'ARG DSH_VERSION=\K\S+' Dockerfile 2>/dev/null | head -1)"
	fi
	printf '%s' "$v"
}

# 从 npm 解析 dsh 的最新版（dist-tags.latest）。构建镜像前用它把版本 pin 进去，
# 否则 Dockerfile / compose 里的默认值会一直是发布时的旧版本 —— 这是最容易踩的坑：
# 「更新了」但装到的还是老版本。
dsh_latest_version() {
	local json tags
	json="$(dsh_npm_json)" || return 1
	if command -v jq >/dev/null 2>&1; then
		tags="$(printf '%s' "$json" | jq -r '."dist-tags".latest // empty' 2>/dev/null)"
	elif command -v node >/dev/null 2>&1; then
		tags="$(printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(String(JSON.parse(s)["dist-tags"].latest||""))}catch(e){process.exit(1)}})' 2>/dev/null)"
	elif command -v python3 >/dev/null 2>&1; then
		tags="$(printf '%s' "$json" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("dist-tags",{}).get("latest",""))' 2>/dev/null)"
	else
		return 1
	fi
	[ -n "$tags" ] || return 1
	printf '%s' "$tags"
}

show_dsh_versions() {
	local json cur latest tags all total shown
	json="$(dsh_npm_json)" || {
		die "无法访问 $DSH_NPM_REGISTRY（需要网络）；可手动查看：
      $DSH_NPM_REGISTRY/$DSH_NPM_NAME"
	}

	all="$(dsh_versions_sorted "$json")" || die "解析 registry 响应失败（需要 jq、node 或 python3 之一）"
	[ -n "$all" ] || die "registry 响应里没有版本信息"

	cur="$(current_dsh_version)"
	tags="$(dsh_dist_tags "$json")"
	latest="$(printf '%s\n' "$all" | tail -1)"
	total="$(printf '%s\n' "$all" | wc -l | tr -d ' ')"

	# --json：给管理面板（以及任何脚本）用的机器可读输出。走这里而不是让调用方去
	# 解析中文表格 —— 那种解析一改格式就坏。
	# 手写 JSON（不引入 jq 依赖），所以必须转义字符串：版本号理论上来自 registry，
	# 仍然按不可信数据转义，避免一个带引号的版本号把面板的 JSON 解析带崩。
	case "${1:-}" in
	--json)
		local esc esc_latest esc_tags
		esc="$(printf '%s' "$cur" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		# latest 也必须转义：它同样来自 registry，不能直接进 printf 的格式串
		esc_latest="$(printf '%s' "$latest" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		esc_tags="$(printf '%s' "$tags" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		printf '{"current":"%s","latest":"%s","total":%s,"distTags":"%s","versions":[' \
			"$esc" "$esc_latest" "$total" "$esc_tags"
		local first=1 v
		while IFS= read -r v; do
			[ -n "$v" ] || continue
			[ "$first" = "1" ] || printf ','
			first=0
			printf '"%s"' "$(printf '%s' "$v" | sed 's/\\/\\\\/g; s/"/\\"/g')"
		done <<EOF
$all
EOF
		printf ']}\n'
		return 0
		;;
	esac

	hdr "dsh 可用版本"
	# 列表可能很长（本仓库实测 29 个），默认只显示最近 10 个，--all 看全部。
	shown="${DSH_VERSIONS_SHOWN:-10}"
	case "${1:-}" in
	--all | -a) shown="$total" ;;
	esac

	printf '    当前运行：%s\n' "${cur:-未知}"
	printf '    最新版本：%s\n' "$latest"
	printf '    发布标签：%s\n' "${tags:-（无）}"
	printf '    共 %s 个版本' "$total"
	[ "$shown" -lt "$total" ] 2>/dev/null && printf '，下面显示最近 %s 个（--all 看全部）' "$shown"
	printf '\n\n'

	printf '%s\n' "$all" | tail -n "$shown" | while IFS= read -r v; do
		if [ "$v" = "$cur" ]; then
			printf '    %s*%s %s  ← 当前\n' "$GRN" "$RST" "$v"
		elif [ "$v" = "$latest" ]; then
			printf '      %s  ← 最新\n' "$v"
		else
			printf '      %s\n' "$v"
		fi
	done

	printf '\n'
	if [ -n "$cur" ] && [ "$cur" != "$latest" ]; then
		warn "有新版本可用：$cur → $latest"
		info "切换版本需要重建镜像（dsh 在构建期装入）："
		printf '\n      ./dshm service update %s\n\n' "$latest"
		info "或指定任意版本： ./dshm service update <版本>"
	else
		ok "已经是最新版本"
	fi
}

# ── 帮助 ────────────────────────────────────────────────────────────────────
help_service() {
	cat <<EOF

${B}服务${RST} — 管理 dsh 容器
  dshm service up [--build]      启动 / 应用 .env 改动
  dshm service down              停止（数据保留）
  dshm service restart           重启（重读 .env 并重建）
  dshm service status            健康 / 端口 / 登录用户（并提示 dsh 是否有新版本）
  dshm service logs              日志
  dshm service shell             进容器
  dshm service version           看全四个版本：配置里钉的 / 镜像 / 容器内实际运行 / npm 最新
  dshm service versions [--all]  列出 npm 上可装的 dsh 版本（--all 显示全部）
  dshm service update [版本] [--build] [--latest]
                                 升级：默认拉预构建镜像（快）
                                 --build  本地构建（改了仓库代码，或要指定 dsh 版本）
                                 --latest 构建前向 npm 查最新 dsh 版本并 pin 进 .env
                                          （不加就永远是 Dockerfile 里写死的旧版本）
  dshm service migrate-home      把旧命名卷 dsh-home 的数据迁到宿主数据目录
                                 （install.sh / service up 已自动执行，通常无需手工调用）
  dshm service url               一次性 launch URL（排障）
  dshm service disk              磁盘占用 / 清理命令
EOF
}

help_auth() {
	cat <<EOF

${B}登录${RST} — 密码与账号
  dshm auth password [用户]      改登录密码（默认 $(env_value DSH_AUTH_USER admin)）
  dshm auth user list            列出登录用户
  dshm auth user add 名字        新建用户 [--admin]
  dshm auth user disable 名字    禁用用户
  dshm auth totp enable [用户]    开启两步验证
  dshm auth totp disable [用户]
EOF
}

help_self() {
	cat <<EOF

${B}自身${RST}
  dshm self install             把 dshm 注册为系统命令（之后任意目录可直接 dshm …）
  dshm self uninstall           移除系统命令
  dshm self update [--force]    从 GitHub 拉取最新的 dshm 覆盖自身（无需 git）
                                git 工作区里会先检查本地是否落后，落后则停下提醒
                                （--force 重新下载，--allow-stale 允许覆盖落后的本地）
EOF
}

show_help() {
	case "${1:-}" in
	service | svc) help_service; return ;;
	auth | login) help_auth; return ;;
	self | cli) help_self; return ;;
	admin | panel)
		# shellcheck source=scripts/admin.sh
		. ./scripts/admin.sh
		admin_help
		return
		;;
	esac
	cat <<EOF

${B}dshm${RST} — DSH 部署管理命令（在当前目录运行）

用法：${B}dshm <分组> <子命令> [参数]${RST}
EOF
	help_service
	help_auth
	cat <<EOF

${B}面板${RST}
  dshm admin install            安装管理面板（宿主机进程）
  dshm admin url|password|status|logs|uninstall
  dshm admin help               面板详细说明
EOF
	help_self
	cat <<EOF

${DIM}旧写法（up / down / restart / status / logs / pw / user / totp / disk / url /
install-self …）仍然可用。分组帮助：dshm service|auth|admin|self help
改运行配置：编辑 .env 后执行 dshm service up${RST}

EOF
}

cmd="${1:-help}"
shift || true

# ── 命令归一化 ──────────────────────────────────────────────────────────────
# 对外主推分组写法 `dshm <分组> <子命令>`，同时把旧的扁平写法
# （dshm up / dshm pw / dshm user add …）继续映射到同一批内部命令，
# 这样已有脚本、文档、肌肉记忆都不会断。分组只做一次翻译，真正的实现仍在
# 下面那个 case 里，避免逻辑分裂成两份。
case "$cmd" in
svc | service)
	sub="${1:-help}"
	shift || true
	if [ "$sub" = "help" ] || [ "$sub" = "-h" ] || [ "$sub" = "--help" ]; then
		cmd=help
		set -- service
	else
		cmd="$sub"
	fi
	;;
login | auth)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	password | passwd | pw) cmd=pw ;;
	user) cmd=user ;;
	totp) cmd=totp ;;
	help | -h | --help | "") cmd=help; set -- auth ;;
	*) die "未知子命令：auth $sub（运行 dshm help）" ;;
	esac
	;;
cli | self)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	install) cmd=install-self ;;
	uninstall) cmd=uninstall-self ;;
	update | upgrade) cmd=update-self ;;
	help | -h | --help | "") cmd=help; set -- self ;;
	*) die "未知子命令：self $sub（运行 dshm help）" ;;
	esac
	;;
panel | admin)
	# shellcheck source=scripts/admin.sh
	. ./scripts/admin.sh
	admin_dispatch "$@"
	exit $?
	;;
esac

case "$cmd" in
up)
	require_docker; require_env
	if [ "${1:-}" = "--build" ]; then
		hdr "本地构建镜像"
		docker compose build
	fi
	prepare_workspace
	# 启动前把生效配置列出来：改没改、改的是哪一项，一眼能看到
	config_summary
	hdr "启动服务"
	docker compose up -d
	hdr "等待健康检查"
	if wait_healthy; then
		bind="$(env_value DSH_BIND 127.0.0.1)"
		port="$(env_value_new DSH_HTTP_PORT 3080)"
		ok "服务已就绪"
		if [ "$bind" = "0.0.0.0" ]; then
			info "访问地址：http://<服务器IP>:${port}/"
		else
			info "只绑定了 127.0.0.1，请在宿主机反代到 127.0.0.1:${port}"
		fi
	else
		# 不加 else 的话，失败时这个 if 返回 0，整个 ./dshm up 会以成功退出 ——
		# 脚本化调用会把「起不来」当成「已就绪」。
		die "容器未在预期时间内健康，请查看 ./dshm service logs"
	fi
	;;

down)
	require_docker
	hdr "停止服务（数据保留）"
	docker compose down
	ok "已停止"
	;;

restart)
	require_docker
	hdr "重启服务（会重新读取 .env）"
	# 用 `up -d` 而不是 `docker compose restart`：后者只是把现有容器里的进程重启，
	# **不会**重读 .env，也不会因 compose 配置变化而重建容器。也就是说改了
	# DSH_UID / DSH_WORKSPACE_HOST / 端口之后 `restart` 看着成功了、实际毫无变化。
	# `up -d` 会按当前 .env 重建有变化的容器，符合「重启使新配置生效」的直觉；
	# 配置没变时它等价于什么都不做（已是最新）。
	prepare_workspace
	docker compose up -d
	wait_healthy || die "容器未在预期时间内健康，请查看 ./dshm service logs"
	ok "已重启并健康"
	;;

logs)
	require_docker
	docker compose logs -f --tail 100
	;;

status)
	require_docker
	hdr "服务状态"
	state="$(docker inspect --format '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo missing)"
	health="$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null || echo -)"
	restarts="$(docker inspect --format '{{.RestartCount}}' "$CONTAINER" 2>/dev/null || echo -)"
	info "状态：${state}    健康：${health}    重启次数：${restarts}"
	info "端口：$(env_value DSH_BIND 127.0.0.1):$(env_value_new DSH_HTTP_PORT 3080) -> 容器 3080"
	info "登录用户：$(env_value DSH_AUTH_USER admin)"
	if [ "$(env_value DSH_BIND 127.0.0.1)" = "0.0.0.0" ]; then
		info "入口：http://<服务器IP>:$(env_value_new DSH_HTTP_PORT 3080)/"
	else
		info "入口：http://127.0.0.1:$(env_value_new DSH_HTTP_PORT 3080)/（仅本机；对外请用反代或 SSH 隧道）"
	fi

	# 顺手看一眼上游有没有新版本 —— 这是「不知不觉就落后了」的解药：跑 status 就能
	# 看到，不必记得主动去查。设 DSHM_SKIP_UPDATE_CHECK=1 可跳过（离线环境）。
	# 查询失败当作「未知」处理，绝不让 status 因此失败或刷红。
	if [ "${DSHM_SKIP_UPDATE_CHECK:-}" != "1" ]; then
		cur_ver="$(current_dsh_version)"
		latest_ver="$(dsh_latest_version 2>/dev/null || true)"
		if [ -n "$cur_ver" ] && [ -n "$latest_ver" ]; then
			if [ "$cur_ver" = "$latest_ver" ]; then
				info "dsh 版本：${cur_ver}（已是最新）"
			else
				printf '    %sdsh 版本：%s → 有新版本 %s%s\n' "$YEL" "$cur_ver" "$latest_ver" "$RST"
				info "升级：./dshm service update --latest"
			fi
		elif [ -n "$cur_ver" ]; then
			info "dsh 版本：${cur_ver}（未能查询上游最新版）"
		fi
	fi
	;;

disk | df)
	require_docker
	hdr "磁盘占用"
	info "宿主："
	df -h / 2>/dev/null | sed 's/^/    /' || true
	if docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
		info "容器内 $(dsh_home_in_container) 所在卷："
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" df -h '$DSH_HOME' 2>/dev/null |
			sed 's/^/    /' || true
		info "占用最大的目录："
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" sh -c \
			'du -xh "$DSH_HOME" --max-depth=2 2>/dev/null | sort -h | tail -10' | sed 's/^/    /' || true
		info "npm 缓存：$(docker exec "$CONTAINER" sh -c 'du -sh /tmp/npm-cache 2>/dev/null | cut -f1' 2>/dev/null || true)"
	else
		info "容器未运行，只显示宿主磁盘。"
	fi
	info "清理："
	info "  docker exec $CONTAINER rm -rf $(dsh_home_in_container)/.npm /tmp/npm-cache"
	info "  docker image prune -a && docker builder prune"
	;;

url)
	require_docker; require_running
	hdr "一次性 launch URL（排障用）"
	docker exec "$CONTAINER" cat "$(dsh_home_in_container)/web-launch-url.txt" 2>/dev/null || info "（暂无）"
	;;

shell)
	require_docker; require_running
	hdr "进入容器（输入 exit 退出）"
	docker exec -it "$CONTAINER" bash
	;;

pw | passwd | password)
	require_docker; require_running
	user="${1:-$(env_value DSH_AUTH_USER admin)}"
	hdr "修改登录密码"
	info "用户：${B}${user}${RST}"
	info "规则：至少 14 位，且包含大写 / 小写 / 数字 / 特殊符号"
	ask_new_password
	# 插件的 user passwd --password-stdin 在管道模式下读两行（密码 + 确认），
	# 只喂一行会报 "passwords do not match"，所以这里喂两行。
	if printf '%s\n%s\n' "$PASSWORD" "$PASSWORD" \
		| docker exec -i -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" \
			user passwd "$user" --password-stdin; then
		ok "密码已更新"
	else
		die "修改失败：请看上面的错误信息（常见原因：用户不存在 / 新密码与旧密码相同 / 密码不合规）"
	fi
	;;

user)
	require_docker; require_running
	sub="${1:-list}"; shift || true
	case "$sub" in
	list | ls)
		hdr "登录用户列表"
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" user list
		;;
	add)
		[ -n "${1:-}" ] || die "用法：./dshm auth user add <用户名> [--admin]"
		name="$1"; shift || true
		hdr "新建用户：${name}"
		extra=""
		for a in "$@"; do
			case "$a" in --admin | --disabled) extra="$extra $a" ;; esac
		done
		ask_new_password
		# shellcheck disable=SC2086
		if printf '%s\n' "$PASSWORD" \
			| docker exec -i -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" \
				user add "$name" --password-stdin $extra; then
			ok "用户 ${name} 已创建"
		else
			die "创建失败（用户名或密码不符合要求）"
		fi
		;;
	disable)
		[ -n "${1:-}" ] || die "用法：./dshm auth user disable <用户名>"
		hdr "禁用用户：${1}"
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" user disable "$1"
		ok "已禁用（并吊销其会话）"
		;;
	*)
		die "未知子命令：user $sub（支持 list / add / disable）"
		;;
	esac
	;;

totp)
	require_docker; require_running
	action="${1:-}"; shift || true
	case "$action" in enable | disable) ;; *) die "用法：./dshm auth totp <enable|disable> [用户名]" ;; esac
	user="${1:-$(env_value DSH_AUTH_USER admin)}"
	hdr "两步验证 ${action}：用户 ${user}"
	docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" user totp "$action" "$user"
	;;

update)
	require_docker; require_env
	# 与 up 一样先做启动前准备：旧键改名、历史默认值对齐、旧卷迁移、目录属主与
	# 私密文件权限预检。以前 update 只改名不做预检，于是「更新后容器仍在重启循环」
	# 时，日志里那条 sudo chown 提示没人执行，文件权限就一直不对。
	prepare_workspace
	target=""; build=0; want_latest=0
	for a in "$@"; do
		case "$a" in
		--build) build=1 ;;
		--latest) want_latest=1 ;;
		-*) die "未知参数：$a（用法：./dshm service update [版本] [--build] [--latest]）" ;;
		*) [ -z "$target" ] || die "只接受一个版本参数（用法：./dshm service update [版本]）"; target="$a" ;;
		esac
	done

	# --latest：构建前向 npm 查最新版并 pin 进 .env。这解决一个很隐蔽的坑 ——
	# Dockerfile / compose / .env.example 里的 DSH_VERSION 是**发布时写死的**，
	# 不查 npm 就永远构建出那个旧版本：「更新过了」但装的还是老 dsh。
	if [ "$want_latest" = "1" ]; then
		[ -z "$target" ] || die "版本参数与 --latest 不能同时给（--latest 就是取最新版）"
		if [ "$build" != "1" ]; then
			info "--latest 需要本地构建（dsh 在构建期装入），已自动加上 --build"
			build=1
		fi
	fi

	img_base="${DSH_IMAGE_BASE:-ghcr.io/qxdho/deepseek-harness-docker}"
	# 不带版本 = 用本项目 CI 构建的最新镜像；带版本 = 用该版本 tag。
	# 两种情况都优先拉取预构建镜像 —— 本地构建要重新装 dsh 并编译原生依赖，很慢。
	tag="${target:-latest}"

	if [ "$build" = "1" ]; then
		if [ "$want_latest" = "1" ]; then
			hdr "查询 npm 上的最新 dsh 版本"
			target="$(dsh_latest_version)" || die "无法从 npm 查询最新版本（需要网络，以及 jq/node/python3 之一）
      也可直接指定版本： ./dshm service update <版本> --build"
			tag="$target"
			ok "最新版本：$target"
		fi
		if [ -n "$target" ]; then
			# 钉进 .env：compose 用 ${DSH_VERSION:-…} 传给构建，不写就退回 Dockerfile 默认值
			set_env DSH_VERSION "$target"
			set_env DSH_IMAGE "${img_base}:${tag}"
			info "已把 DSH_VERSION=${target} 写入 .env（构建时使用）"
		else
			warn "未指定版本，将按当前配置里的 dsh 版本构建："
			printf '        Dockerfile 默认 %s，.env 当前 %s\n' \
				"$(grep -oP 'ARG DSH_VERSION=\K\S+' Dockerfile 2>/dev/null | head -1)" \
				"$(env_value_new DSH_VERSION 未设置)"
			info "要装 npm 上的最新版： ./dshm service update --latest"
		fi
		hdr "本地构建镜像（--build）"
		docker compose build
	else
		set_env DSH_IMAGE "${img_base}:${tag}"
		hdr "拉取预构建镜像"
		info "${img_base}:${tag}"
		if docker compose pull; then
			ok "已拉取镜像"
		else
			warn "没有可用的预构建镜像 ${img_base}:${tag}，改为本地构建（较慢）"
			[ -n "$target" ] && set_env DSH_VERSION "$target"
			docker compose build
		fi
	fi

	config_summary
	hdr "重建容器"
	docker compose up -d
	if wait_healthy; then
		ok "已更新（容器内 dsh 版本：$(docker exec "$CONTAINER" dsh --version 2>/dev/null || echo 未知)）"
	else
		die "更新后容器未健康，请查看 ./dshm service logs"
	fi
	;;

version)
	# 一次看全四个「版本」—— 用户问「我是什么版本」时，其实想知道这几件事，而它们
	# 可能互不相同：
	#   1. .env 里钉的（下次构建/拉取会得到什么）
	#   2. DSH_IMAGE 标签（拉的哪个镜像）
	#   3. 容器内实际运行（真在跑什么）
	#   4. npm 最新（可以要什么）
	# 只报其中一个是以前的做法，容易让人误判「我升级了但没变」。
	hdr "dsh 版本"
	require_docker

	pinned="$(env_value_new DSH_VERSION "")"
	[ -n "$pinned" ] || pinned="$(awk -F= '/^ARG DSH_VERSION=/{print $2}' Dockerfile 2>/dev/null | head -1)"
	img="$(env_value DSH_IMAGE "")"

	running=""
	if docker inspect "$CONTAINER" >/dev/null 2>&1; then
		running="$(docker exec "$CONTAINER" dsh --version 2>/dev/null || true)"
	fi

	latest="$(dsh_latest_version 2>/dev/null || true)"

	# 注意：printf 的 %-Ns 按**字节**算宽度，中文标签用它反而对不齐；而「中文占 2 列」
	# 又让手工数空格很脆弱。这里把标签和其后的空格都写死，四行按**显示宽度 16 列**对齐
	# （配置里钉的版本：=16、容器内实际运行：=16、镜像：+10 空格=16、npm 最新：+6 空格=16）。
	printf '    %s %s\n' "配置里钉的版本：" "${pinned:-未知}"
	[ -n "$img" ] && printf '    %s %s\n' "镜像：          " "$img"
	printf '    %s %s\n' "容器内实际运行：" "${running:-（容器未运行）}"
	printf '    %s %s\n' "npm 最新：      " "${latest:-（查询失败）}"

	# 只在与「实际运行」不一致时告警 —— 配置改了但没应用是最常见的困惑来源
	if [ -n "$running" ] && [ -n "$pinned" ] && [ "$running" != "$pinned" ]; then
		warn "容器内运行的版本与配置里钉的不一致"
		info "应用配置：./dshm service up"
	fi
	if [ -n "$latest" ] && [ -n "$running" ] && [ "$running" != "$latest" ]; then
		printf '\n'
		info "升级到最新：./dshm service update --latest"
	fi
	;;

versions)
	# 列出 npm 上可装的 dsh 版本，并标出当前镜像里跑的是哪个。
	# 换版本要重建镜像（dsh 是构建期 npm install -g 装进去的），所以这里只负责
	# 「看有哪些版本」，实际切换用 `dshm service update <版本>` 或面板。
	show_dsh_versions "$@"
	;;

migrate-home | migrate)
	# 旧版本把 DSH_HOME 放在命名卷 dsh-home 里；现在默认是宿主 bind 挂载。
	# 实现放在 scripts/migrate-home.sh（install.sh 与 dshm service up 会自动调用），
	# 这里保留显式入口，供自动迁移跳过时手工收尾。
	require_docker
	set +e
	migrate_legacy_home explicit
	rc=$?
	set -e
	case "$rc" in
	1) ok "没找到旧的 dsh-home 命名卷，无需迁移" ;;
	2) die "$(env_value DSH_HOME_HOST /dsh) 里已有数据，为避免覆盖请先自行确认；手工迁移命令见 README「从旧版本升级」" ;;
	esac
	;;

install-self | link | install-cli)
	install_self
	;;

uninstall-self | unlink)
	uninstall_self
	;;

update-self)
	self_update "$@"
	;;

help | -h | --help | "")
	show_help "$@"
	;;

*)
	die "未知命令：${cmd}（运行 dshm help 查看帮助）"
	;;
esac
