#!/usr/bin/env bash
# dshm — DSH 部署管理命令（在项目目录里运行：./dshm <命令>）
#
# 只保留一套写法：dshm <分组> <子命令>。旧的扁平写法已移除（会提示新写法）。
# 完整说明见 `dshm help`。
#
#   dshm service up|down|restart|status|logs|shell|url
#   dshm version show|list|update
#   dshm auth    password|user|totp
#   dshm admin   install|uninstall|url|password|status|logs
#   dshm dshm    install|uninstall|update
set -euo pipefail

# `dshm dshm install` 会把自己软链到 PATH 里，之后可能以符号链接身份被调用。
# 所以先解析出脚本的真实路径再 cd —— 否则 `dirname "$0"` 会落在符号链接所在的
# 目录（如 /usr/local/bin），后面所有相对路径都会找错地方。
SELF="$0"
while [ -L "$SELF" ]; do
	_link="$(readlink "$SELF")"
	case "$_link" in
	/*) SELF="$_link" ;;
	*) SELF="$(dirname "$SELF")/$_link" ;;
	esac
done
PROJECT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
cd "$PROJECT_DIR"

CLI_NAME=dshm
ENV_FILE=.env
CONTAINER=qxdho-dsh
dsh_home_in_container() { env_value_new DSH_HOME_CONTAINER /dsh; }
cli_in_container() { printf "%s/profiles/web/node_modules/dsh-auth-gate/lib/cli.js" "$(dsh_home_in_container)"; }

# ── 输出样式 ────────────────────────────────────────────────────────────────
# 与 scripts/release.sh 共用同一份实现，避免两处颜色/格式慢慢跑偏。
# shellcheck source=scripts/log.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scripts/log.sh"

require_docker() {
	command -v docker >/dev/null 2>&1 || die "未找到 docker"
	docker compose version >/dev/null 2>&1 || die "未找到 docker compose v2"
}
require_env() { [ -f "$ENV_FILE" ] || die "缺少 .env，请先运行 ./install.sh"; }
require_running() {
	docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true \
		|| die "容器 $CONTAINER 没在运行，先执行 ./dshm service up"
}
# .env 的读写统一走 lib，和 install.sh 共用一份实现，避免两套解析器慢慢跑偏。
# shellcheck source=scripts/env-config.sh
. ./scripts/env-config.sh
# 旧命名卷 → 宿主目录的搬迁同样共用一份实现（install.sh 也会 source 它）
# shellcheck source=scripts/migrate-home.sh
. ./scripts/migrate-home.sh

# ── 注册为系统命令 ──────────────────────────────────────────────────────────
is_root() { [ "$(id -u)" = "0" ]; }

# dshm 自身从哪更新。可用 DSHM_REPO 覆盖（fork 或内网镜像）。
DSHM_REPO_URL="${DSHM_REPO:-https://github.com/qxdho/deepseek-harness-docker}"

# dshm 自身的版本号。**唯一真源是仓库根的 VERSION 文件**：
#   * 在仓库里(有 VERSION 文件)时直接读它 —— 开发/自用场景
#   * 发布版由 CI 在打包时把下面的占位符替换成实际版本 —— 部署机没有 VERSION 文件
# 同样的版本号也注入给面板(-ldflags)，所以「面板是 dshm 的附属功能、两者同版本」
# 这件事是被机制保证的，不靠人记。
DSHM_VERSION_RAW="${DSHM_VERSION:-__VERSION__}"

dshm_version() {
	# 1) 发布版：CI 已把占位符替换成实际版本，直接用
	if [ "$DSHM_VERSION_RAW" != "__VERSION__" ]; then
		printf '%s' "$DSHM_VERSION_RAW"
		return
	fi

	# 2) 在 git 工作区：用 `git describe` 如实反映**手上的代码**
	#    不能在 main 上直接读 VERSION 文件：VERSION 会在「准备发布」的那个提交里
	#    先被 bump，而 tag 可能还没打；那时读文件会声称自己是那个版本，实际手上的
	#    代码并没有对应的发布 tag。用 describe 判断才准：
	#      * HEAD 正好有 tag        → 报该 tag 的版本（与那次发布完全一致）
	#      * 在 tag 之后又有新提交   → <VERSION>-<提交数>-g<短SHA>，明确表示「领先」
	#      * main 上还没有任何 tag   → dev + 短 SHA
	if [ -d "$PROJECT_DIR/.git" ] && command -v git >/dev/null 2>&1 &&
		git -C "$PROJECT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
		local desc sha
		sha="$(git -C "$PROJECT_DIR" rev-parse --short HEAD 2>/dev/null || true)"
		desc="$(git -C "$PROJECT_DIR" describe --tags --match 'v[0-9]*' 2>/dev/null || true)"
		if [ -n "$desc" ]; then
			# v2026.09.30 或 v2026.09.30-3-gabc1234 → 去掉 v，保留「领先几个提交」的后缀
			printf '%s' "${desc#v}"
			return
		fi
		if [ -f "$PROJECT_DIR/VERSION" ]; then
			# 有 VERSION 说明「准备发这个版本」，但还没 tag —— 说清楚，别冒充已发布
			printf '%s-dev' "$(tr -d ' \t\r\n' <"$PROJECT_DIR/VERSION")"
		elif [ -n "$sha" ]; then
			printf 'dev-%s' "$sha"
		else
			printf 'dev'
		fi
		return
	fi

	# 3) 既不是发布版，也没有 git 仓库
	if [ -f "$PROJECT_DIR/VERSION" ]; then
		tr -d ' \t\r\n' <"$PROJECT_DIR/VERSION"
	else
		printf 'dev'
	fi
}

# ── 发布 tag（dshm 的版本只认 tag）─────────────────────────────────────────
#
# 核心原则：**只认 tag，绝不跟随 main**。跟随 main 就等于会把「你还没决定发布的、
# 某个中间提交」装到生产上。tag 是你明确说「这个版本可以发」的唯一信号。
#
# 约定：dshm 的发布 tag 形如 v2026.09.30（带 v 前缀，否则 CI 的 refs/tags/v* 不触发）。

# 列出全部 dshm 发布 tag（降序，最新在前）。取不到就返回非 0。
dshm_tags() {
	command -v git >/dev/null 2>&1 || return 1
	local raw
	raw="$(timeout 20 git ls-remote --tags --refs "$DSHM_REPO_URL" 2>/dev/null)" || return 1
	printf '%s\n' "$raw" |
		awk -F'refs/tags/' 'NF==2 && $2 ~ /^v[0-9]/{print $1 "\t" $2}' |
		while IFS="$(printf '\t')" read -r sha tag; do
			printf '%s %s\n' "$sha" "${tag#v}"
		done |
	# -V（版本感知）而不是普通降序：字符串排序会把 2026.09.9 排在 2026.09.30 前面。
	# 零填充的日期不受影响，但既然容易踩就一次做对。
		sort -k2,2rV
}

dshm_latest_tag() {
	dshm_tags 2>/dev/null | head -1 | awk '{print $2}'
}

# 某个 tag 对应的 commit（找不到就返回非 0）
dshm_tag_sha() {
	local want="$1"
	command -v git >/dev/null 2>&1 || return 1
	timeout 20 git ls-remote --tags --refs "$DSHM_REPO_URL" "refs/tags/v${want}" 2>/dev/null |
		awk 'NR==1{print $1}'
}

# 该 tag 对应的 dshm 脚本下载地址
dshm_raw_url() {
	local ver="$1"
	printf 'https://raw.githubusercontent.com/qxdho/deepseek-harness-docker/v%s/%s' "$ver" "$CLI_NAME"
}

# 该 tag 的 release **发布包**（dshm 的完整运行目录，版本号已由 CI 写死）。
# 这是首选下载地址：自更新的目标机器通常既没有 git 仓库也没有 VERSION 文件，
# 用仓库里的原始文件不但版本号会退化成 dev，而且单独一个脚本根本跑不起来 ——
# dshm 会 source 同目录的 scripts/env-config.sh 等文件。
dshm_release_url() {
	local ver="$1"
	printf 'https://github.com/qxdho/deepseek-harness-docker/releases/download/v%s/dshm-v%s.tar.gz' "$ver" "$ver"
}

# 放系统命令的目录：优先 /usr/local/bin（可写 / root / 免密 sudo），否则 ~/.local/bin。
# 只认免密 sudo，避免 `sudo -n false` 时卡在密码提示上。
cli_dir() {
	if [ -w /usr/local/bin ] 2>/dev/null || is_root; then
		printf '%s' /usr/local/bin
	elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
		printf '%s' /usr/local/bin
	else
		printf '%s' "${HOME}/.local/bin"
	fi
}

install_self() {
	hdr "把 dshm 注册为系统命令"
	local dir target
	dir="$(cli_dir)"
	target="$dir/$CLI_NAME"
	chmod +x "$PROJECT_DIR/$CLI_NAME" 2>/dev/null || true
	# 先把目录建出来（~/.local/bin 通常还不存在），再判断可写性
	if ! mkdir -p "$dir" 2>/dev/null; then
		if command -v sudo >/dev/null 2>&1; then
			sudo mkdir -p "$dir" || die "无法创建 $dir"
		else
			die "无法创建 $dir（需要 root 或 sudo）"
		fi
	fi
	if [ -w "$dir" ] || is_root; then
		ln -sfn "$PROJECT_DIR/$CLI_NAME" "$target"
	elif command -v sudo >/dev/null 2>&1; then
		sudo ln -sfn "$PROJECT_DIR/$CLI_NAME" "$target"
	else
		die "无法写入 $dir（需要 root、可写的目标目录，或已安装 sudo）"
	fi
	[ -L "$target" ] || die "创建链接失败：$target"
	ok "已注册：${target} -> ${PROJECT_DIR}/${CLI_NAME}"
	case ":$PATH:" in
	*":$dir:"*)
		info "现在可在任意目录直接运行： dshm status"
		;;
	*)
		warn "$dir 不在 PATH 中，把下面一行加到 ~/.bashrc 或 ~/.zshrc："
		printf '\n    export PATH="%s:$PATH"\n\n' "$dir"
		;;
	esac
}

uninstall_self() {
	hdr "移除系统命令"
	local dir target found=0
	for dir in /usr/local/bin "${HOME}/.local/bin"; do
		target="$dir/$CLI_NAME"
		[ -L "$target" ] || continue
		found=1
		if [ -w "$dir" ] 2>/dev/null || is_root; then
			rm -f "$target"
		elif command -v sudo >/dev/null 2>&1; then
			sudo rm -f "$target"
		else
			warn "无法移除 $target（权限不足）"
			continue
		fi
		ok "已移除 $target"
	done
	[ "$found" = "1" ] || info "没有找到注册的符号链接（可能未安装过）"
}

# ── dshm 自更新（只认 tag）──────────────────────────────────────────────────
#
# **只从发布 tag 拉取，绝不跟随 main。** 跟随 main 意味着会把「你还没决定发布的
# 某个中间提交」装到生产上；tag 是你明确说「这个版本可以发」的唯一信号。
#
# 适用场景：只装了 dshm（或已注册为系统命令）、没保留 git 仓库的部署机。
# 在 git 工作区里请用 git pull —— 那样能拿到 tag 之后的提交，而且不会覆盖本地改动。
#
# 安全措施：
#   1. 下载到临时文件 → `bash -n` 语法检查 → 特征串检查，再替换（断网不会留半截脚本）
#   2. 同目录内 install（原子），保留原文件权限位
#   3. 内容相同则跳过，--force 才强制
#   4. 在 git 工作区里默认停下（除非 --allow-stale），避免静默覆盖你的本地改动
self_update() {
	hdr "更新 dshm 自身"
	local force=0 allow_stale=0 target=""
	# 必须用 while + shift，不能用 `for a in "$@"`：for 会**先展开整个参数列表**，
	# 循环体里的 shift 只影响 $1、不影响已展开的迭代序列 —— 于是 `--to 2026.10.01`
	# 在处理 --to 时正确取到版本号后，又会把同一个版本号当成新参数再走一遍，
	# 报出莫名其妙的「未知参数：2026.10.01」。while 按语义逐个消费才正确。
	while [ $# -gt 0 ]; do
		case "$1" in
		--force | -f) force=1 ;;
		--allow-stale) allow_stale=1 ;;
		--to)
			target="${2:-}"
			[ -n "$target" ] || die "--to 需要版本号（用法：./dshm dshm update --to 2026.10.01）"
			shift
			;;
		--to=*) target="${1#--to=}" ;;
		*) die "未知参数：$1（用法：./dshm dshm update [--to 版本] [--force] [--allow-stale]）" ;;
		esac
		shift
	done

	command -v curl >/dev/null 2>&1 || die "需要 curl 才能自更新（或改用 git pull）"

	local cur
	cur="$(dshm_version)"

	# 没有指定版本时，取最新 tag。取不到 tag 就明确说清 —— 绝不回退到 main。
	if [ -z "$target" ]; then
		target="$(dshm_latest_tag 2>/dev/null || true)"
		if [ -z "$target" ]; then
			die "尚未发布任何版本 tag，无法更新。

  dshm 只从发布 tag 更新，不跟随 main —— 以免装到你还没决定发布的中间提交。
  当前可用方式：
    * 在 git 工作区里：git pull
    * 发布一个版本：git tag v$(date +%Y.%m.%d) && git push origin v$(date +%Y.%m.%d)"
		fi
		info "最新发布版本：v${target}"
	fi

	# 确认目标 tag 真实存在（打错版本号时立刻报错，而不是下到一个 404 页面）
	local sha
	sha="$(dshm_tag_sha "$target" 2>/dev/null || true)"
	if [ -z "$sha" ]; then
		warn "找不到 tag v${target}，已发布的版本："
		if ! dshm_tags 2>/dev/null | awk '{print $2}' | sed 's/^/        /' ; then
			printf '        （查询失败，检查网络）\n'
		fi
		die "无效的版本：${target}"
	fi

	if [ "$force" != "1" ] && [ "$cur" = "$target" ]; then
		ok "已经是该版本（v${cur}），无需更新"
		info "如确实要重新下载，加 --force"
		return 0
	fi

	# git 工作区里默认停下：自更新会用 tag 版覆盖你的工作树文件，
	# 包括 tag 之后你新写的提交 —— 那等于把你的改动回退了。
	if [ -d "$PROJECT_DIR/.git" ] && command -v git >/dev/null 2>&1 && [ "$allow_stale" != "1" ]; then
		warn "当前目录是 git 工作区，推荐用 git pull 更新"
		if [ "$cur" != "$target" ]; then
			warn "若继续，会用 v${target} 的 dshm 覆盖你工作树里的文件（含 tag 之后的提交改动）"
		fi
		die "已停下以免覆盖你的本地改动。
      确认要继续：./dshm dshm update --to ${target} --allow-stale"
	fi

	# 从该 tag 的 **release 包**下载。包里是 dshm 的完整运行目录：
	#   dshm                                        脚本本身（版本号已被 CI 写死）
	#   scripts/{env-config,migrate-home,admin}.sh  它 source 的依赖
	#
	# 为什么必须整包：dshm 会 source 同目录下的这几个文件，单独一个脚本在任何地方都
	# 跑不起来。而本命令面向的是没保留 git 仓库的部署机，它没有这些文件。
	#
	# 为什么用 release 而不是仓库原始文件：仓库里的 dshm 带 __VERSION__ 占位符，靠
	# git / VERSION 文件推断版本；部署机两者都没有，不替换的话版本号会退化成 dev。
	local tgz_url sha_url
	tgz_url="$(dshm_release_url "$target")"
	sha_url="${tgz_url}.sha256"

	local tgz workdir
	tgz="$(mktemp "${TMPDIR:-/tmp}/dshm.XXXXXX.tgz")"
	workdir="$(mktemp -d "${TMPDIR:-/tmp}/dshm.XXXXXX")"
	# 任何提前 return / die 都清掉临时物；安装成功后再显式清空
	trap 'rm -rf "$tgz" "$workdir" 2>/dev/null || true' RETURN

	info "下载 $tgz_url"
	if ! curl -fsSL -o "$tgz" "$tgz_url"; then
		rm -f "$tgz"
		die "下载失败：$tgz_url
      tag v${target} 的 release 里可能还没有 dshm 发布包（CI 尚未发布完成）。
      也可用镜像地址：DSHM_REPO 指向你的 fork / 内网镜像"
	fi

	# 校验 sha256（CI 会一并发布 .sha256）。取不到校验文件只警告不阻断 ——
	# 可能是较早的发布没有附带，但仍然值得装。
	local want got
	# 末尾的 || true 必需：curl 对该文件返回非 0 时，pipefail 会让整条赋值失败，
	# 而 set -e 会直接终止脚本 —— 下面「取不到只警告」的分支根本走不到（实测复现）。
	want="$(curl -fsSL --max-time 30 "$sha_url" 2>/dev/null | awk 'NR==1{print $1}' || true)"
	if [ -n "$want" ]; then
		got="$(sha256sum "$tgz" | cut -d' ' -f1)"
		if [ "$want" != "$got" ]; then
			die "下载包校验失败（期望 ${want}，实际 ${got}），已放弃安装（现有文件未改动）"
		fi
		ok "校验通过（sha256 ${got%"${got#???????}"}…）"
	else
		warn "该版本没有附带 .sha256 校验文件，跳过完整性校验"
	fi

	# 先在临时目录解包并**全部**验证完，任何一步不过都不碰现有文件
	tar -xzf "$tgz" -C "$workdir" || die "解包失败（文件可能损坏）"
	local src="$workdir/dshm-v${target}"
	[ -f "$src/dshm" ] || die "发布包里缺少 dshm（包结构异常）"
	local f
	for f in scripts/env-config.sh scripts/migrate-home.sh scripts/admin.sh; do
		[ -f "$src/$f" ] || die "发布包里缺少 $f（包结构异常）"
	done
	# 语法自检：宁可继续用旧版本，也不能换成跑不起来的脚本
	bash -n "$src/dshm" 2>/dev/null || die "下载到的 dshm 未通过语法检查，已放弃替换（原文件未改动）"
	# 内容自检：确认确实是本项目脚本，而不是错误页 / 代理返回的 HTML
	grep -q 'dshm dshm' "$src/dshm" || die "下载到的内容不像 dshm（缺少预期特征），已放弃替换"

	local curfile="$PROJECT_DIR/$CLI_NAME"
	local mode
	mode="$(stat -c '%a' "$curfile" 2>/dev/null || echo 755)"
	# 是否需要用 sudo 安装（只判断一次，后面所有文件共用）
	local use_sudo=0
	if [ ! -w "$curfile" ] && [ ! -w "$PROJECT_DIR" ]; then
		command -v sudo >/dev/null 2>&1 || die "无法写入 $PROJECT_DIR（需要它可写，或用 sudo）"
		use_sudo=1
	fi

	if [ "$force" != "1" ] && [ -f "$curfile" ] \
		&& [ "$(sha256sum "$curfile" | cut -d' ' -f1)" = "$(sha256sum "$src/dshm" | cut -d' ' -f1)" ]; then
		ok "脚本内容与该版本一致，无需更新"
		info "如确实要重新安装整个包，加 --force"
		return 0
	fi

	# 安装：脚本 + 依赖，全部来自刚验证过的 $src，不改动其它文件
	mkdir -p "$PROJECT_DIR/scripts"
	if [ "$use_sudo" = "1" ]; then
		sudo install -m "$mode" "$src/dshm" "$curfile" &&
			sudo cp "$src/scripts/"*.sh "$PROJECT_DIR/scripts/" ||
			die "安装失败（sudo 出错）"
	else
		install -m "$mode" "$src/dshm" "$curfile" &&
			cp "$src/scripts/"*.sh "$PROJECT_DIR/scripts/" ||
			die "安装失败"
	fi
	ok "已更新到 v${target}：$curfile（含 scripts/ 依赖）"
	[ "$cur" != "$target" ] && info "版本：v${cur} → v${target}"
	info "仓库：$DSHM_REPO_URL"
}

# ── 密码合规检查 ────────────────────────────────────────────────────────────
# 规则本身写在 scripts/env-config.sh 的 env_validate_password 里（install.sh 也用
# 那一份），这里只把「不合规」从「返回 1」翻译成「直接退出」。
check_password() {
	env_validate_password "$1" || die "密码不合规（至少 14 位，且含大写/小写/数字/特殊符号）"
}

PASSWORD=""
ask_new_password() {
	local p1 p2
	while :; do
		read_secret "  新密码（≥14位，含大写/小写/数字/符号）："
		p1="$SECRET"
		read_secret "  再输一次确认："
		p2="$SECRET"
		# 非交互模式（管道）下 stdin 耗尽会一直读到空串，p1 != p2 永远成立 →
		# 无限循环。检测到空输入直接报错，别让调用方挂住。
		if [ ! -t 0 ] && { [ -z "$p1" ] || [ -z "$p2" ]; }; then
			die "非交互模式下读取密码失败（输入为空或已到 EOF）；改密码请交互执行 ./dshm auth password"
		fi
		if [ "$p1" != "$p2" ]; then
			printf '  %s两次输入不一致，请重新输入%s\n' "$YEL" "$RST"
			continue
		fi
		check_password "$p1"
		PASSWORD="$p1"
		return
	done
}

