cmd="${1:-help}"
shift || true

# 旧扁平写法 → 新分组写法的提示表。
#
# 旧写法已全部移除（只保留一套写法，否则帮助会变长、新用户不知道该学哪个），但直接
# 报「未知命令」对老用户太不友好 —— 他们只会看到自己用惯的命令突然不工作了。
# 这里给出确切的替代写法。
LEGACY_CMD_MAP="
up=service up
down=service down
restart=service restart
status=service status
logs=service logs
shell=service shell
url=service url
update=version update
version=version show
versions=version list
disk=disk
pw=auth password
passwd=auth password
password=auth password
user=auth user
totp=auth totp
migrate-home=migrate
migrate=migrate
install-self=dshm install
uninstall-self=dshm uninstall
update-self=dshm update
self=dshm
cli=dshm
svc=service
login=auth
panel=admin
link=dshm install
unlink=dshm uninstall
install-cli=dshm install
df=disk
list=version list
"

unknown_cmd() {
	local old="$1" hit
	# 精确匹配（一行一个 key=value），避免前缀误判
	hit="$(printf '%s\n' "$LEGACY_CMD_MAP" | awk -F= -v k="$old" '$1==k{print $2; exit}')"
	if [ -n "$hit" ]; then
		die "命令 '${old}' 已改为分组写法：${B}dshm ${hit}${RST}

  旧写法已全部移除，只保留一套写法。运行 dshm help 看完整命令表。"
	fi
	case "$old" in
	svc | login | cli | panel)
		die "分组名 '${old}' 是旧简称，已移除。请用完整名：service / auth / dshm / admin"
		;;
	esac
	die "未知命令：${old}（运行 dshm help 查看帮助）"
}

# ── 命令分发 ────────────────────────────────────────────────────────────────
#
# 只保留一套写法：`dshm <分组> <子命令>`。旧的扁平写法（dshm up / dshm pw …）与
# 分组简称（svc / login / cli / panel）**已全部移除** —— 同时维护两套写法会让帮助
# 变长、新用户不知道该学哪个。旧写法会命中下面的 unknown_cmd，给出新写法提示。
#
# 版本管理独立成 `version` 分组（show / list / update）：它有三个命令和一整套
# 「四个版本」的语义，塞在 service 里会让那个分组变成杂物袋；而且原来的
# `version` 与 `versions` 只差一个字母、语义却不同，最容易看错。
#
# `dshm dshm` 用来管理 dshm 自身（install / uninstall / update），对齐
# 「npm install npm」「pip install --upgrade pip」这类工具的惯例。
#
# 裸分组名（`dshm service`、`dshm version` …）等同该分组的 help。必须放在分组 case
# **之前**：那个 case 会把 cmd 重新赋成内部命令名，之后再判"是否裸分组名"就太晚了。
case "$cmd" in
service | version | auth | dshm)
	[ $# -eq 0 ] && set -- help
	;;
esac

case "$cmd" in
service)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	help | -h | --help) cmd=help; set -- service ;;
	up | down | restart | status | logs | shell | url) cmd="service-$sub" ;;
	*) die "未知子命令：service $sub（支持 up / down / restart / status / logs / shell / url；运行 dshm service help）" ;;
	esac
	;;
version)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	help | -h | --help | "") cmd=help; set -- version ;;
	show) cmd=version-show ;;
	list) cmd=version-list ;;
	update) cmd=version-update ;;
	*) die "未知子命令：version $sub（支持 show / list / update；运行 dshm version help）" ;;
	esac
	;;
auth)
	sub="${1:-help}"
	shift || true
	case "$sub" in
	help | -h | --help) cmd=help; set -- auth ;;
	password) cmd=auth-password ;;
	user | totp) cmd="auth-$sub" ;;
	*) die "未知子命令：auth $sub（支持 password / user / totp；运行 dshm auth help）" ;;
	esac
	;;
dshm)
	sub="${1:-help}"
	shift || true
	# 注意：这里**不再多 shift 一次**。子命令后面的参数本来就留在 $@ 里
	# （与 `dshm service up --build` 同理），会自然传给主 case 的分支。
	case "$sub" in
	help | -h | --help) cmd=help; set -- dshm ;;
	version | "") cmd=dshm-version ;;
	list) cmd=dshm-list ;;
	install) cmd=dshm-install ;;
	uninstall) cmd=dshm-uninstall ;;
	update) cmd=dshm-update ;;
	*) die "未知子命令：dshm $sub（支持 version / list / install / uninstall / update；运行 dshm dshm help）" ;;
	esac
	;;
admin)
	# 面板命令多且实现独立，交给 scripts/admin.sh 自己分发
	# shellcheck source=scripts/admin.sh
	. ./scripts/admin.sh
	admin_dispatch "$@"
	exit $?
	;;
disk | migrate | help | -h | --help | "") ;;
*)
	unknown_cmd "$cmd"
	;;
esac

case "$cmd" in
service-up)
	require_docker; require_env
	if [ "${1:-}" = "--build" ]; then
		hdr "本地构建镜像"
		docker compose build
	fi
	prepare_workspace
	# 启动前把生效配置列出来：改没改、改的是哪一项，一眼能看到
	config_summary
	hdr "启动服务"
	docker compose up -d
	hdr "等待健康检查"
	if wait_healthy; then
		bind="$(env_value DSH_BIND 127.0.0.1)"
		port="$(env_value_new DSH_HTTP_PORT 3080)"
		ok "服务已就绪"
		if [ "$bind" = "0.0.0.0" ]; then
			info "访问地址：http://<服务器IP>:${port}/"
		else
			info "只绑定了 127.0.0.1，请在宿主机反代到 127.0.0.1:${port}"
		fi
	else
		# 不加 else 的话，失败时这个 if 返回 0，整个 ./dshm up 会以成功退出 ——
		# 脚本化调用会把「起不来」当成「已就绪」。
		die "容器未在预期时间内健康，请查看 ./dshm service logs"
	fi
	;;

service-down)
	require_docker
	hdr "停止服务（数据保留）"
	docker compose down
	ok "已停止"
	;;

service-restart)
	require_docker
	hdr "重启服务（会重新读取 .env）"
	# 用 `up -d` 而不是 `docker compose restart`：后者只是把现有容器里的进程重启，
	# **不会**重读 .env，也不会因 compose 配置变化而重建容器。也就是说改了
	# DSH_UID / DSH_WORKSPACE_HOST / 端口之后 `restart` 看着成功了、实际毫无变化。
	# `up -d` 会按当前 .env 重建有变化的容器，符合「重启使新配置生效」的直觉；
	# 配置没变时它等价于什么都不做（已是最新）。
	prepare_workspace
	docker compose up -d
	wait_healthy || die "容器未在预期时间内健康，请查看 ./dshm service logs"
	ok "已重启并健康"
	;;

service-logs)
	require_docker
	docker compose logs -f --tail 100
	;;

service-status)
	require_docker
	hdr "服务状态"
	state="$(docker inspect --format '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo missing)"
	health="$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER" 2>/dev/null || echo -)"
	restarts="$(docker inspect --format '{{.RestartCount}}' "$CONTAINER" 2>/dev/null || echo -)"
	info "状态：${state}    健康：${health}    重启次数：${restarts}"
	info "端口：$(env_value DSH_BIND 127.0.0.1):$(env_value_new DSH_HTTP_PORT 3080) -> 容器 3080"
	info "登录用户：$(env_value DSH_AUTH_USER admin)"
	if [ "$(env_value DSH_BIND 127.0.0.1)" = "0.0.0.0" ]; then
		info "入口：http://<服务器IP>:$(env_value_new DSH_HTTP_PORT 3080)/"
	else
		info "入口：http://127.0.0.1:$(env_value_new DSH_HTTP_PORT 3080)/（仅本机；对外请用反代或 SSH 隧道）"
	fi

	# 顺手看一眼上游有没有新版本 —— 这是「不知不觉就落后了」的解药：跑 status 就能
	# 看到，不必记得主动去查。设 DSHM_SKIP_UPDATE_CHECK=1 可跳过（离线环境）。
	# 查询失败当作「未知」处理，绝不让 status 因此失败或刷红。
	if [ "${DSHM_SKIP_UPDATE_CHECK:-}" != "1" ]; then
		cur_ver="$(current_dsh_version)"
		latest_ver="$(dsh_latest_version 2>/dev/null || true)"
		if [ -n "$cur_ver" ] && [ -n "$latest_ver" ]; then
			if [ "$cur_ver" = "$latest_ver" ]; then
				info "dsh 版本：${cur_ver}（已是最新）"
			else
				printf '    %sdsh 版本：%s → 有新版本 %s%s\n' "$YEL" "$cur_ver" "$latest_ver" "$RST"
				info "升级：./dshm version update"
			fi
		elif [ -n "$cur_ver" ]; then
			info "dsh 版本：${cur_ver}（未能查询上游最新版）"
		fi
	fi
	;;

disk)
	require_docker
	hdr "磁盘占用"
	info "宿主："
	df -h / 2>/dev/null | sed 's/^/    /' || true
	if docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
		info "容器内 $(dsh_home_in_container) 所在卷："
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" sh -c 'df -h "$DSH_HOME"' 2>/dev/null |
			sed 's/^/    /' || true
		info "占用最大的目录："
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" sh -c \
			'du -xh "$DSH_HOME" --max-depth=2 2>/dev/null | sort -h | tail -10' | sed 's/^/    /' || true
		info "npm 缓存：$(docker exec "$CONTAINER" sh -c 'du -sh /tmp/npm-cache 2>/dev/null | cut -f1' 2>/dev/null || true)"
	else
		info "容器未运行，只显示宿主磁盘。"
	fi
	info "清理："
	info "  docker exec $CONTAINER rm -rf $(dsh_home_in_container)/.npm /tmp/npm-cache"
	info "  docker image prune -a && docker builder prune"
	;;

service-url)
	require_docker; require_running
	hdr "一次性 launch URL（排障用）"
	docker exec "$CONTAINER" cat "$(dsh_home_in_container)/web-launch-url.txt" 2>/dev/null || info "（暂无）"
	;;

service-shell)
	require_docker; require_running
	hdr "进入容器（输入 exit 退出）"
	docker exec -it "$CONTAINER" bash
	;;

auth-password)
	require_docker; require_running
	user="${1:-$(env_value DSH_AUTH_USER admin)}"
	hdr "修改登录密码"
	info "用户：${B}${user}${RST}"
	info "规则：至少 14 位，且包含大写 / 小写 / 数字 / 特殊符号"
	ask_new_password
	# 插件的 user passwd --password-stdin 在管道模式下读两行（密码 + 确认），
	# 只喂一行会报 "passwords do not match"，所以这里喂两行。
	if printf '%s\n%s\n' "$PASSWORD" "$PASSWORD" \
		| docker exec -i -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" \
			user passwd "$user" --password-stdin; then
		ok "密码已更新"
	else
		die "修改失败：请看上面的错误信息（常见原因：用户不存在 / 新密码与旧密码相同 / 密码不合规）"
	fi
	;;

auth-user)
	require_docker; require_running
	sub="${1:-list}"; shift || true
	case "$sub" in
	list | ls)
		hdr "登录用户列表"
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" user list
		;;
	add)
		[ -n "${1:-}" ] || die "用法：./dshm auth user add <用户名> [--admin]"
		name="$1"; shift || true
		hdr "新建用户：${name}"
		extra=""
		for a in "$@"; do
			case "$a" in --admin | --disabled) extra="$extra $a" ;; esac
		done
		ask_new_password
		# shellcheck disable=SC2086
		if printf '%s\n' "$PASSWORD" \
			| docker exec -i -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" \
				user add "$name" --password-stdin $extra; then
			ok "用户 ${name} 已创建"
		else
			die "创建失败（用户名或密码不符合要求）"
		fi
		;;
	disable)
		[ -n "${1:-}" ] || die "用法：./dshm auth user disable <用户名>"
		hdr "禁用用户：${1}"
		docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" user disable "$1"
		ok "已禁用（并吊销其会话）"
		;;
	*)
		die "未知子命令：user $sub（支持 list / add / disable）"
		;;
	esac
	;;

auth-totp)
	require_docker; require_running
	action="${1:-}"; shift || true
	case "$action" in enable | disable) ;; *) die "用法：./dshm auth totp <enable|disable> [用户名]" ;; esac
	user="${1:-$(env_value DSH_AUTH_USER admin)}"
	hdr "两步验证 ${action}：用户 ${user}"
	docker exec -e DSH_HOME="$(dsh_home_in_container)" "$CONTAINER" node "$(cli_in_container)" user totp "$action" "$user"
	;;

version-update)
	require_docker
	# 参数解析放在环境检查**之前**：参数写错就该立刻报错，而不是先跑一遍工作区预检、
	# 最后才说「未知参数」。预检会改 .env、可能要求 chown，走完再报参数错纯属浪费，
	# 还会让人误以为是自己环境有问题。
	# 参数：
	#   （无）           拉取已构建的最新镜像（快，优先）
	#   --to <镜像tag>   拉取指定镜像（回退用），如 --to 0.2.0-rc.2-2026.09.30-1
	#   --build          本地构建（慢）。默认用 npm 上的最新 dsh 版本
	#   --build --dsh <版本>   本地构建并指定 dsh 版本
	target=""; build=0; dsh_ver=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--build) build=1 ;;
		--dsh)
			shift
			dsh_ver="${1:-}"
			[ -n "$dsh_ver" ] || die "--dsh 需要版本号（用法：./dshm version update --build --dsh 0.2.0-rc.2）"
			;;
		--dsh=*) dsh_ver="${1#--dsh=}" ;;
		--to)
			shift
			target="${1:-}"
			[ -n "$target" ] || die "--to 需要镜像 tag（用法：./dshm version update --to 0.2.0-rc.2-2026.09.30-1）
      可先用 ./dshm version list 查看有哪些已构建的镜像"
			;;
		--to=*) target="${1#--to=}" ;;
		--latest)
			die "--latest 已移除。改用：
      ./dshm version update --build            本地构建，用 npm 最新版
      ./dshm version update --build --dsh 版本  本地构建并指定版本"
			;;
		-*) die "未知参数：$1（用法：./dshm version update [--to <镜像tag>] [--build [--dsh <版本>]]）" ;;
		*) die "不接受的参数：$1（指定版本请用 --dsh 或 --to，见 ./dshm version help）" ;;
		esac
		shift
	done

	[ -n "$dsh_ver" ] && [ "$build" != "1" ] && die "--dsh 只在 --build 下有意义（--dsh 指定的是本地构建用的 dsh 版本）"

	# 参数已确认，现在做环境检查（会改 .env、可能要求修属主，属于有副作用的操作）
	require_env
	# 与 up 一样先做启动前准备：旧键改名、历史默认值对齐、旧卷迁移、目录属主与
	# 私密文件权限预检。以前 update 只改名不做预检，于是「更新后容器仍在重启循环」
	# 时，日志里那条 sudo chown 提示没人执行，文件权限就一直不对。
	prepare_workspace

	base="$(img_base)"
	# 不带 --to = 用 CI 构建的最新镜像；带 --to = 用指定的那个构建（回退用）。
	# 两种情况都优先拉取预构建镜像 —— 本地构建要重新装 dsh 并编译原生依赖，很慢。
	tag="${target:-latest}"

	if [ "$build" = "1" ]; then
		if [ -z "$dsh_ver" ]; then
			# 不指定就用 npm 最新版。这一步解决一个很隐蔽的坑：Dockerfile /
			# compose / .env.example 里的 DSH_VERSION 是**发布时写死的**，
			# 不查 npm 就永远构建出那个旧版本 —— 「更新过了」但装的还是老 dsh。
			hdr "查询 npm 上的最新 dsh 版本"
			dsh_ver="$(dsh_latest_version)" || die "无法从 npm 查询最新版本（需要网络，以及 jq/node/python3 之一）
      也可直接指定： ./dshm version update --build --dsh <版本>"
			ok "将构建 dsh ${dsh_ver}"
		else
			# 用户明确指定了版本，先确认它在 npm 上存在 —— 打错字立即报错，
			# 而不是等几分钟构建失败
			if ! dsh_version_exists "$dsh_ver"; then
				die "npm 上没有 dsh ${dsh_ver} 这个版本（可用 ./dshm version list 查看）"
			fi
		fi
		# 钉进 .env：compose 用 ${DSH_VERSION:-…} 传给构建，不写就退回 Dockerfile 默认值
		set_env DSH_VERSION "$dsh_ver"
		set_env DSH_IMAGE "${base}:${dsh_ver}-local"
		info "已把 DSH_VERSION=${dsh_ver} 写入 .env"
		hdr "本地构建镜像"
		docker compose build
	else
		# 拉取前先确认该 tag 真的存在，避免 compose 报一句难懂的拉取失败
		if [ -n "$target" ] && ! img_tag_exists "$target"; then
			warn "镜像仓库里没有 tag ${target}"
			info "用 ./dshm version list 查看已构建的镜像"
			die "无效的镜像 tag：${target}"
		fi
		set_env DSH_IMAGE "${base}:${tag}"
		hdr "拉取预构建镜像"
		info "${base}:${tag}"
		if docker compose pull; then
			ok "已拉取镜像"
		else
			warn "拉取失败。这个版本的镜像可能还没构建出来。"
			info "要本地构建（较慢）：./dshm version update --build"
			info "或先看有哪些现成镜像：./dshm version list"
			die "没有可用的预构建镜像 ${base}:${tag}"
		fi
	fi

	config_summary
	hdr "重建容器"
	docker compose up -d
	if wait_healthy; then
		ok "已更新（容器内 dsh 版本：$(docker exec "$CONTAINER" dsh --version 2>/dev/null || echo 未知)）"
	else
		die "更新后容器未健康，请查看 ./dshm service logs"
	fi
	;;

version-show)
	# 一次看全四个「版本」—— 用户问「我是什么版本」时，其实想知道这几件事，而它们
	# 可能互不相同：
	#   1. .env 里钉的（下次构建/拉取会得到什么）
	#   2. DSH_IMAGE 标签（拉的哪个镜像）
	#   3. 容器内实际运行（真在跑什么）
	#   4. npm 最新（可以要什么）
	# 只报其中一个是以前的做法，容易让人误判「我升级了但没变」。
	hdr "dsh 版本"
	require_docker

	pinned="$(env_value_new DSH_VERSION "")"
	[ -n "$pinned" ] || pinned="$(dockerfile_arg DSH_VERSION)"
	img="$(env_value DSH_IMAGE "")"

	running=""
	if docker inspect "$CONTAINER" >/dev/null 2>&1; then
		running="$(docker exec "$CONTAINER" dsh --version 2>/dev/null || true)"
	fi

	latest="$(dsh_latest_version 2>/dev/null || true)"

	# 注意：printf 的 %-Ns 按**字节**算宽度，中文标签用它反而对不齐；而「中文占 2 列」
	# 又让手工数空格很脆弱。这里把标签和其后的空格都写死，四行按**显示宽度 16 列**对齐
	# （配置里钉的版本：=16、容器内实际运行：=16、镜像：+10 空格=16、npm 最新：+6 空格=16）。
	printf '    %s %s\n' "配置里钉的版本：" "${pinned:-未知}"
	[ -n "$img" ] && printf '    %s %s\n' "镜像：          " "$img"
	printf '    %s %s\n' "容器内实际运行：" "${running:-（容器未运行）}"
	printf '    %s %s\n' "npm 最新：      " "${latest:-（查询失败）}"

	# 只在与「实际运行」不一致时告警 —— 配置改了但没应用是最常见的困惑来源
	if [ -n "$running" ] && [ -n "$pinned" ] && [ "$running" != "$pinned" ]; then
		warn "容器内运行的版本与配置里钉的不一致"
		info "应用配置：./dshm service up"
	fi
	if [ -n "$latest" ] && [ -n "$running" ] && [ "$running" != "$latest" ]; then
		printf '\n'
		info "升级：./dshm version update"
	fi
	;;

version-list)
	# 列两类东西：能否装到某个 dsh 版本，取决于你能不能构建。
	#   1. 已构建好的镜像 tag —— 可直接拉取（快）
	#   2. npm 上可用的 dsh 版本 —— 需要本地构建（慢）
	hdr "可安装的镜像（已构建）"
	cur_img="$(env_value DSH_IMAGE "")"
	if tags="$(img_tags 2>/dev/null)"; then
		# 末尾的 || true 是必需的：grep 无匹配时退出码为 1，而 dshm 顶部开了
		# set -euo pipefail —— 管道里这一步失败会让整条赋值失败，进而被 set -e 直接
		# 终止脚本。表现是「只打印标题就退出，退出码 1，且不报任何错」，极难定位。
		# 镜像仓库里还没有新格式 tag 时就会命中。
		built="$(printf '%s\n' "$tags" | grep -E '^[0-9].*-[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[0-9]+$' | sort -rV || true)"
		if [ -n "$built" ]; then
			n="$(printf '%s\n' "$built" | grep -c . || true)"
			printf '%s\n' "$built" | head -20 | while read -r t; do
				case "$cur_img" in
				*":${t}") printf '    %s*%s %s  ← 当前配置\n' "$GRN" "$RST" "$t" ;;
				*) printf '      %s\n' "$t" ;;
				esac
			done
			[ "$n" -gt 20 ] && info "（共 ${n} 个，只显示最近 20 个）"
			printf '\n'
			info "装指定镜像（可回退）：./dshm version update --to <上面的 tag>"
		else
			info "镜像仓库里还没有形如 <dsh版本>-<日期>-<序号> 的构建。"
		fi
	else
		warn "无法查询镜像 tag（网络或仓库权限问题）"
	fi

	printf '\n'
	hdr "npm 上可装的 dsh 版本（需本地构建）"
	show_dsh_versions "$@"
	;;

migrate)
	# 旧版本把 DSH_HOME 放在命名卷 dsh-home 里；现在默认是宿主 bind 挂载。
	# 实现放在 scripts/migrate-home.sh（install.sh 与 dshm service up 会自动调用），
	# 这里保留显式入口，供自动迁移跳过时手工收尾。
	require_docker
	set +e
	migrate_legacy_home explicit
	rc=$?
	set -e
	case "$rc" in
	1) ok "没找到旧的 dsh-home 命名卷，无需迁移" ;;
	2) die "$(env_value DSH_HOME_HOST /dsh) 里已有数据，为避免覆盖请先自行确认；手工迁移命令见 README「从旧版本升级」" ;;
	esac
	;;

dshm-version)
	# dshm 自己的版本。与 dsh 容器版本完全无关（那个在 version 分组）。
	hdr "dshm 版本"
	cur="$(dshm_version)"
	printf '    %s\n' "本地版本：    v${cur}"

	# 面板是 dshm 的附属功能，同版本发布 —— 这里顺带确认二进制是否在位。
	# 这里不能用 admin_dir()：它定义在 scripts/admin.sh 里，而本分支（dshm dshm version）
	# 并没有 source 那个文件 —— 未定义时命令替换为空，实际会判断 /dsh-admin，
	# 于是面板即使装在别处也永远显示「未安装」。直接读 .env 里的配置值即可。
	panel_dir="$(env_value DSH_ADMIN_DIR /dsh-manager)"
	if [ -x "$panel_dir/dsh-admin" ]; then
		printf '    %s\n' "管理面板：    已安装（与 dshm 同版本）"
	else
		printf '    %s\n' "管理面板：    未安装（./dshm admin install）"
	fi

	# 只比 tag：没有 tag 就老实说无法比较，绝不去比 main。
	latest="$(dshm_latest_tag 2>/dev/null || true)"
	printf '\n'
	if [ -z "$latest" ]; then
		info "尚未发布任何版本 tag，无法比较是否有新版。"
		info "发布：git tag v$(date +%Y.%m.%d) && git push origin v$(date +%Y.%m.%d)"
	elif [ "$cur" = "$latest" ]; then
		ok "已是最新发布版本（v${latest}）"
	elif [ -n "$(git -C "$PROJECT_DIR" describe --tags --match "v${latest}" HEAD 2>/dev/null || true)" ]; then
		# 本地从最新 tag 出发又有新提交（git describe 会给出 v<tag>-<n>-g<sha>）。
		# 这是**领先**，不能报「有新版」—— 那会误导用户去执行一次回退。
		ok "本地领先最新发布版本（v${latest} + 尚未发布的提交）"
		info "要把这些改动发出去：./scripts/release.sh"
	else
		printf '    %s有新版：v%s → v%s%s\n' "$YEL" "$cur" "$latest" "$RST"
		info "更新：./dshm dshm update"
	fi
	info "查看全部版本：./dshm dshm list"
	;;

dshm-list)
	# 列出全部已发布的 dshm 版本（tag）。用户靠它决定 --to 哪个版本。
	hdr "dshm 已发布的版本"
	cur="$(dshm_version)"
	tags="$(dshm_tags 2>/dev/null || true)"
	if [ -z "$tags" ]; then
		warn "尚未发布任何版本 tag。"
		info "dshm 只从 tag 更新，不跟随 main —— 以免装到未决定发布的中间提交。"
		info "发布：git tag v$(date +%Y.%m.%d) && git push origin v$(date +%Y.%m.%d)"
		exit 0
	fi
	printf '%s\n' "$tags" | while read -r sha ver; do
		if [ "$ver" = "$cur" ]; then
			printf '    %s*%s v%s  ← 当前（%s）\n' "$GRN" "$RST" "$ver" "${sha%"${sha#???????}"}"
		else
			printf '      v%s  (%s)\n' "$ver" "${sha%"${sha#???????}"}"
		fi
	done
	printf '\n'
	info "装指定版本（可回退）：./dshm dshm update --to <版本>"
	;;

dshm-install)
	install_self
	;;

dshm-uninstall)
	uninstall_self
	;;

dshm-update)
	self_update "$@"
	;;

help | -h | --help | "")
	show_help "$@"
	;;

*)
	die "未知命令：${cmd}（运行 dshm help 查看帮助）"
	;;
esac
