#!/usr/bin/env bash
# 容器内自更新 dsh 与 dsh-auth-gate。
#
# 装进持久化 npm prefix（$DSH_HOME/npm-global），重建容器也不丢；
# dsh wrapper 会优先使用这份。重启容器后生效。
#
#   docker exec -it dsh dsh-update                 # dsh 最新版
#   docker exec -it dsh dsh-update 0.1.7-rc.2      # 指定 dsh 版本
#   docker exec -it dsh dsh-update-gate 0.15.0     # 升级登录插件（可选）
#   docker compose restart dsh
#
# 回滚：删除 $DSH_HOME/npm-global 后重启。
set -euo pipefail

version="${1:-latest}"
prefix="${DSH_HOME:-/home/node/.dsh}/npm-global"

echo "dsh-update: 安装 @deepseek-ai/dsh@${version} 到 ${prefix}"
npm install --global --prefix "$prefix" --no-audit --no-fund "@deepseek-ai/dsh@${version}"
echo "dsh-update: 当前版本 $(dsh --version)"
echo "dsh-update: 执行 'docker compose restart dsh' 生效。"
